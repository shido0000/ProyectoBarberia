@model List<WebApplication1.Models.SubscriptionPlan>
@{
    ViewData["Title"] = "Gestionar Planes de Suscripción";
}

<!-- Page Header with Animation -->
<div class="admin-header-section mb-5 animate-fade-in-down">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="icon-wrapper">
                        <div class="bg-theme-primary rounded-circle d-inline-flex align-items-center justify-content-center shadow-glow" style="width: 64px; height: 64px;">
                            <i class="bi bi-star-fill text-theme-inverse" style="font-size: 1.75rem;"></i>
                        </div>
                    </div>
                    <div>
                        <h1 class="display-6 fw-bold mb-1 gradient-text">Planes de Suscripción</h1>
                        <p class="text-muted mb-0">Administra los planes disponibles para los barberos</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a asp-controller="SubscriptionAdmin" asp-action="Create" class="btn btn-primary btn-lg btn-animated shadow-glow">
                    <i class="bi bi-plus-circle"></i> Nuevo Plan
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Alert Messages -->
@if (TempData["Success"] != null)
{
    <div class="container mb-4">
        <div class="alert alert-success alert-custom alert-dismissible fade show animate-fade-in-up" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <span>@TempData["Success"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="container mb-4">
        <div class="alert alert-danger alert-custom alert-dismissible fade show animate-fade-in-up" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <span>@TempData["Error"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<div class="container pb-5">
    <!-- Stats Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="stat-card glass-card animate-fade-in-up" style="animation-delay: 0.1s;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <div class="stat-value text-primary mb-1">@Model.Count</div>
                        <div class="stat-label">Planes Totales</div>
                    </div>
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                        <i class="bi bi-layers fs-4"></i>
                    </div>
                </div>
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: 100%"></div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card glass-card animate-fade-in-up" style="animation-delay: 0.2s;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <div class="stat-value text-success mb-1">@Model.Count(p => p.IsActive)</div>
                        <div class="stat-label">Planes Activos</div>
                    </div>
                    <div class="stat-icon bg-success bg-opacity-10 text-success rounded-3 p-3">
                        <i class="bi bi-check-circle fs-4"></i>
                    </div>
                </div>
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @(Model.Any() ? (Model.Count(p => p.IsActive) * 100 / Model.Count) : 0)%"></div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card glass-card animate-fade-in-up" style="animation-delay: 0.3s;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <div class="stat-value text-warning mb-1">@ViewBag.TotalSubscriptions</div>
                        <div class="stat-label">Suscripciones Activas</div>
                    </div>
                    <div class="stat-icon bg-warning bg-opacity-10 text-warning rounded-3 p-3">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                </div>
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar bg-warning" role="progressbar" style="width: 75%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Plans Grid -->
    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var plan in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 glass-card border-0 animate-fade-in-up shadow-md @(plan.IsDefault ? "border-primary border-2" : "")" style="transition: all 0.3s ease;">
                        @if (plan.IsDefault)
                        {
                            <div class="card-header bg-theme-primary text-theme-inverse text-center py-2">
                                <i class="bi bi-star-fill me-1"></i> Plan por Defecto
                            </div>
                        }
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h4 class="card-title fw-bold mb-0 gradient-text">@plan.Name</h4>
                                @if (plan.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success">
                                        <i class="bi bi-check-circle me-1"></i>Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary">
                                        <i class="bi bi-pause-circle me-1"></i>Inactivo
                                    </span>
                                }
                            </div>
                            
                            @if (!string.IsNullOrEmpty(plan.Description))
                            {
                                <p class="text-muted small mb-3">@plan.Description</p>
                            }
                            
                            <div class="mb-4 p-3 rounded-3" style="background: linear-gradient(135deg, rgba(37,99,235,0.05), rgba(124,58,237,0.05));">
                                <h3 class="text-primary fw-bold mb-0">
                                    $@plan.MonthlyPrice.ToString("F2")
                                    <small class="text-muted fs-6">/mes</small>
                                </h3>
                                @if (plan.AnnualPrice.HasValue)
                                {
                                    var savings = plan.MonthlyPrice > 0 ? ((plan.MonthlyPrice * 12 - plan.AnnualPrice.Value) / (plan.MonthlyPrice * 12) * 100) : 0;
                                    <div class="mt-2">
                                        <small class="text-success fw-semibold">$@plan.AnnualPrice.Value.ToString("F2")/año</small>
                                        <span class="badge bg-success bg-opacity-10 text-success ms-2">
                                            Ahorra @savings.ToString("F0")%
                                        </span>
                                    </div>
                                }
                            </div>
                            
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <small class="text-muted d-block">
                                        <i class="bi bi-people me-1 text-primary"></i>
                                        Barberos: <strong>@(plan.MaxBarbers.HasValue ? plan.MaxBarbers.Value.ToString() : "Ilimitados")</strong>
                                    </small>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">
                                        <i class="bi bi-scissors me-1 text-primary"></i>
                                        Servicios: <strong>@(plan.MaxServicesPerBarber.HasValue ? plan.MaxServicesPerBarber.Value.ToString() : "Ilimitados")</strong>
                                    </small>
                                </div>
                                <div class="col-12">
                                    <small class="text-muted d-block">
                                        <i class="bi bi-calendar me-1 text-primary"></i>
                                        Duración: <strong>@plan.DurationDays días</strong>
                                    </small>
                                </div>
                            </div>
                            
                            <hr class="my-3" />
                            
                            <div class="mb-4">
                                <h6 class="fw-bold mb-3"><i class="bi bi-check2-square text-primary me-2"></i>Características:</h6>
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-2 d-flex align-items-center">
                                        <i class="bi bi-@(plan.IncludeAnalytics ? "check-circle-fill text-success" : "x-circle-fill text-danger") me-2 fs-5"></i>
                                        <span class="@(plan.IncludeAnalytics ? "" : "text-muted")">Analytics</span>
                                    </li>
                                    <li class="mb-2 d-flex align-items-center">
                                        <i class="bi bi-@(plan.PrioritySupport ? "check-circle-fill text-success" : "x-circle-fill text-danger") me-2 fs-5"></i>
                                        <span class="@(plan.PrioritySupport ? "" : "text-muted")">Soporte Prioritario</span>
                                    </li>
                                    <li class="mb-2 d-flex align-items-center">
                                        <i class="bi bi-@(plan.CustomBranding ? "check-circle-fill text-success" : "x-circle-fill text-danger") me-2 fs-5"></i>
                                        <span class="@(plan.CustomBranding ? "" : "text-muted")">Branding Personalizado</span>
                                    </li>
                                    <li class="mb-2 d-flex align-items-center">
                                        <i class="bi bi-@(plan.AutoReminders ? "check-circle-fill text-success" : "x-circle-fill text-danger") me-2 fs-5"></i>
                                        <span class="@(plan.AutoReminders ? "" : "text-muted")">Recordatorios Automáticos</span>
                                    </li>
                                    <li class="d-flex align-items-center">
                                        <i class="bi bi-@(plan.ExportReports ? "check-circle-fill text-success" : "x-circle-fill text-danger") me-2 fs-5"></i>
                                        <span class="@(plan.ExportReports ? "" : "text-muted")">Exportar Reportes</span>
                                    </li>
                                </ul>
                            </div>
                            
                            <div class="d-grid gap-2">
                                <div class="btn-group w-100" role="group">
                                    <a asp-controller="SubscriptionAdmin" asp-action="Edit" asp-route-id="@plan.Id" class="btn btn-sm btn-outline-primary btn-animated">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <form asp-controller="SubscriptionAdmin" asp-action="TogglePlanStatus" asp-route-id="@plan.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm @(plan.IsActive ? "btn-outline-warning" : "btn-outline-success") btn-animated">
                                            <i class="bi bi-@(plan.IsActive ? "pause" : "play")-circle"></i> @(plan.IsActive ? "Desactivar" : "Activar")
                                        </button>
                                    </form>
                                </div>
                                <form asp-controller="SubscriptionAdmin" asp-action="Delete" asp-route-id="@plan.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100 btn-animated" 
                                            onclick="return confirm('¿Estás seguro de eliminar este plan?')">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="glass-card p-5 text-center animate-fade-in-up">
            <div class="bg-theme-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-4 mx-auto shadow-glow" style="width: 140px; height: 140px;">
                <i class="bi bi-star text-theme-inverse" style="font-size: 4rem;"></i>
            </div>
            <h4 class="fw-bold mb-2 gradient-text">No hay planes de suscripción</h4>
            <p class="text-muted mb-4">Crea tu primer plan para empezar a ofrecer suscripciones</p>
            <a asp-controller="SubscriptionAdmin" asp-action="Create" class="btn btn-primary btn-lg btn-animated shadow-glow">
                <i class="bi bi-plus-circle me-2"></i>Crear Primer Plan
            </a>
        </div>
    }
</div>
