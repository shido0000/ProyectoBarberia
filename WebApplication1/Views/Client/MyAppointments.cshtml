@model List<WebApplication1.Models.Appointment>
@{
    ViewData["Title"] = "Mis Reservaciones";
}

<!-- Page Header -->
<div class="row mb-4 section-header">
    <div class="col-12">
        <h2 class="fw-bold mb-2 text-gradient">
            <i class="bi bi-calendar-check me-2"></i>Mis Reservaciones
        </h2>
        <p class="text-muted mb-0">Gestiona tus citas con los mejores barberos</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Any())
{
    <!-- Desktop Table View -->
    <div class="card shadow-md d-none d-md-block border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Barbero</th>
                            <th>Servicio</th>
                            <th>Fecha</th>
                            <th>Hora</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model)
                        {
                            <tr>
                                <td>
                                    <strong class="fs-5">@appt.BarberProfile.ShopName</strong>
                                </td>
                                <td>@appt.Service.Name</td>
                                <td>@appt.Date.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge bg-primary fs-6 px-3 py-2">@appt.Time.ToString(@"hh\:mm")</span></td>
                                <td>
                                    @{
                                        var badgeClass = appt.Status switch
                                        {
                                            WebApplication1.Models.AppointmentStatus.Pending => "bg-warning text-dark",
                                            WebApplication1.Models.AppointmentStatus.Confirmed => "bg-info",
                                            WebApplication1.Models.AppointmentStatus.InProgress => "bg-primary",
                                            WebApplication1.Models.AppointmentStatus.Completed => "bg-success",
                                            WebApplication1.Models.AppointmentStatus.Cancelled => "bg-secondary",
                                            _ => "bg-secondary"
                                        };
                                        var statusText = appt.Status switch
                                        {
                                            WebApplication1.Models.AppointmentStatus.Pending => "Pendiente",
                                            WebApplication1.Models.AppointmentStatus.Confirmed => "Confirmada",
                                            WebApplication1.Models.AppointmentStatus.InProgress => "En Progreso",
                                            WebApplication1.Models.AppointmentStatus.Completed => "Completada",
                                            WebApplication1.Models.AppointmentStatus.Cancelled => "Cancelada",
                                            _ => "Desconocido"
                                        };
                                    }
                                    <span class="badge @badgeClass px-3 py-2">@statusText</span>
                                </td>
                                <td class="text-center">
                                    @if (appt.Status == WebApplication1.Models.AppointmentStatus.Pending || appt.Status == WebApplication1.Models.AppointmentStatus.Confirmed)
                                    {
                                        <form asp-controller="Client" asp-action="CancelAppointment" asp-route-id="@appt.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-danger btn-sm" 
                                                    onclick="return confirm('¿Estás seguro de cancelar esta reservación?')">
                                                <i class="bi bi-x-circle me-1"></i>Cancelar
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <!-- Mobile Cards View -->
    <div class="d-md-none">
        @foreach (var appt in Model)
        {
            <div class="card shadow-md mb-3 border-0">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="fw-bold mb-1">@appt.BarberProfile.ShopName</h5>
                            <p class="text-muted small mb-1">@appt.Service.Name</p>
                        </div>
                        @{
                            var badgeClass = appt.Status switch
                            {
                                WebApplication1.Models.AppointmentStatus.Pending => "bg-warning text-dark",
                                WebApplication1.Models.AppointmentStatus.Confirmed => "bg-info",
                                WebApplication1.Models.AppointmentStatus.InProgress => "bg-primary",
                                WebApplication1.Models.AppointmentStatus.Completed => "bg-success",
                                WebApplication1.Models.AppointmentStatus.Cancelled => "bg-secondary",
                                _ => "bg-secondary"
                            };
                            var statusText = appt.Status switch
                            {
                                WebApplication1.Models.AppointmentStatus.Pending => "Pendiente",
                                WebApplication1.Models.AppointmentStatus.Confirmed => "Confirmada",
                                WebApplication1.Models.AppointmentStatus.InProgress => "En Progreso",
                                WebApplication1.Models.AppointmentStatus.Completed => "Completada",
                                WebApplication1.Models.AppointmentStatus.Cancelled => "Cancelada",
                                _ => "Desconocido"
                            };
                        }
                        <span class="badge @badgeClass px-3 py-2">@statusText</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-4 bg-light p-3 rounded">
                        <div class="small fw-semibold">
                            <i class="bi bi-calendar3 text-primary me-1"></i>@appt.Date.ToString("dd/MM/yyyy")
                            <span class="mx-2">|</span>
                            <i class="bi bi-clock-fill text-primary me-1"></i>@appt.Time.ToString(@"hh\:mm")
                        </div>
                        @if (appt.Status == WebApplication1.Models.AppointmentStatus.Pending || appt.Status == WebApplication1.Models.AppointmentStatus.Confirmed)
                        {
                            <form asp-controller="Client" asp-action="CancelAppointment" asp-route-id="@appt.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-danger btn-sm" 
                                        onclick="return confirm('¿Cancelar esta reserva?')">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-4 mx-auto" style="width: 140px; height: 140px;">
            <i class="bi bi-calendar-x text-muted" style="font-size: 4rem;"></i>
        </div>
        <h4 class="text-muted mb-2">No tienes reservaciones</h4>
        <p class="text-muted mb-4">¡Reserva tu primera cita con un barbero!</p>
        <a asp-controller="Booking" asp-action="Index" class="btn btn-primary btn-lg shadow-glow">
            <i class="bi bi-search me-2"></i>Buscar Barberos
        </a>
    </div>
}
