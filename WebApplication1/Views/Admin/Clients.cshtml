@model List<WebApplication1.Models.ApplicationUser>
@{
    ViewData["Title"] = "Gestión de Clientes";
}

<!-- Header Section -->
<div class="container py-4">
    <div class="row mb-4 align-items-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                    <i class="bi bi-person-check text-success fs-4"></i>
                </div>
                <div>
                    <h1 class="display-6 fw-bold mb-1 gradient-text">Gestión de Clientes</h1>
                    <p class="text-muted mb-0">Administra todos los clientes registrados en la plataforma</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-glass">
                <i class="bi bi-arrow-left me-2"></i>Volver al Panel
            </a>
        </div>
    </div>

    <!-- Stats Summary -->
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="glass-card p-3 text-center">
                <div class="stat-number text-success" style="font-size: 2rem;">@Model.Count</div>
                <div class="stat-label">Total Clientes</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="glass-card p-3 text-center">
                <div class="stat-number text-info" style="font-size: 2rem;">@Model.Sum(c => c.ClientAppointments?.Count ?? 0)</div>
                <div class="stat-label">Reservas Totales</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="glass-card p-3 text-center">
                <div class="stat-number text-primary" style="font-size: 2rem;">@Model.Count(c => !string.IsNullOrEmpty(c.PhoneNumber))</div>
                <div class="stat-label">Con Teléfono</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="glass-card p-3 text-center">
                <div class="stat-number text-warning" style="font-size: 2rem;">@Model.OrderByDescending(c => c.CreatedAt).FirstOrDefault()?.CreatedAt.ToString("yyyy")</div>
                <div class="stat-label">Año Inicio</div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="glass-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-success bg-gradient text-white">
                        <tr>
                            <th class="ps-4">Cliente</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Fecha de Registro</th>
                            <th class="text-center">Total Reservas</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var client in Model.OrderBy(c => c.FullName))
                        {
                            var appointmentCount = client.ClientAppointments?.Count ?? 0;
                            <tr class="animate-fade-in">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; flex-shrink: 0;">
                                            <i class="bi bi-person-circle text-success fs-5"></i>
                                        </div>
                                        <div>
                                            <strong class="d-block">@client.FullName</strong>
                                            <small class="text-muted">Cliente desde @client.CreatedAt.ToString("MMM yyyy")</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-envelope text-muted small"></i>
                                        <span>@client.Email</span>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(client.PhoneNumber))
                                    {
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-phone me-1"></i>@client.PhoneNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><i class="bi bi-dash-circle me-1"></i>No registrado</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-secondary small">
                                        <i class="bi bi-calendar-event me-1"></i>@client.CreatedAt.ToString("dd/MM/yyyy")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (appointmentCount > 0)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">
                                            <i class="bi bi-calendar-check me-1"></i>@appointmentCount @(appointmentCount == 1 ? "reserva" : "reservas")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 rounded-pill">
                                            <i class="bi bi-calendar-x me-1"></i>Sin reservas
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 96px; height: 96px;">
                <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
            </div>
            <h4 class="text-muted">No hay clientes registrados</h4>
            <p class="text-muted">Los clientes aparecerán aquí una vez que se registren en la plataforma.</p>
        </div>
    }
</div>
