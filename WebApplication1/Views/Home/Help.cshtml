                                                    <li>Activar/desactivar cuenta</li>
                                                    <li>Eliminar usuario (con confirmación)</li>
                                                </ul>
                                            </li>
                                            <li>Revisa historial de actividad.</li>
                                            <li>Gestiona permisos especiales si es necesario.</li>
                                        </ol>
                                    </div>
                                </div>
                            </div>

                            <!-- Reportes -->
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#admin-collapse5">
