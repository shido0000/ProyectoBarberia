@model WebApplication1.Models.ApplicationUser
@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-person"></i> Mi Perfil</h4>
            </div>
            <div class="card-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">
                        <i class="bi bi-check-circle"></i> @TempData["Success"]
                    </div>
                }
                
                <div class="text-center mb-4">
                    <i class="bi bi-person-circle text-primary" style="font-size: 5rem;"></i>
                    <h3 class="mt-3">@Model.FullName</h3>
                    <p class="text-muted">@Model.Email</p>
                </div>
                
                <form asp-controller="Client" asp-action="UpdateProfile" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre Completo</label>
                        <input type="text" name="fullName" value="@Model.FullName" class="form-control form-control-lg" required />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email</label>
                        <input type="email" value="@Model.Email" class="form-control form-control-lg" disabled />
                        <small class="text-muted">El email no se puede cambiar</small>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold">Teléfono</label>
                        <input type="tel" name="phone" value="@Model.PhoneNumber" class="form-control form-control-lg" placeholder="+1234567890" />
                    </div>
                    
                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        <i class="bi bi-check-circle"></i> Guardar Cambios
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
