@{
    ViewData["Title"] = "Inicio";
}

<!-- Hero Section -->
<section class="hero-section position-relative overflow-hidden">
    <div class="hero-gradient-bg"></div>
    <div class="container position-relative z-2 py-5">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-7 text-center text-lg-start">
                <div class="d-flex justify-content-center justify-content-lg-start mb-4">
                    <span class="glass-card px-3 py-1 small fw-semibold">
                        <i class="bi bi-stars me-1 text-primary"></i> Plataforma #1 en Latinoamérica
                    </span>
                </div>
                <h1 class="display-large mb-4">
                    Gestiona tu barbería con <span class="text-gradient">tecnología de punta</span>
                </h1>
                <p class="lead text-secondary mb-4" style="max-width: 600px;">
                    Sistema todo-en-uno para reservas, gestión de clientes y pagos. Aumenta tus ingresos y reduce ausencias con recordatorios automáticos.
                </p>
                <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                    @if (!User.Identity?.IsAuthenticated ?? true)
                    {
                        <a asp-controller="Booking" asp-action="Index" class="btn btn-primary btn-lg px-5">
                            <i class="bi bi-calendar-plus me-2"></i>Ver Disponibilidad
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-glass btn-lg px-5">
                            <i class="bi bi-person-plus me-2"></i>Registro Gratis
                        </a>
                    }
                    else if (User.IsInRole("Client"))
                    {
                        <a asp-controller="Booking" asp-action="Index" class="btn btn-primary btn-lg px-5">
                            <i class="bi bi-calendar-plus me-2"></i>Reservar Ahora
                        </a>
                        <a asp-controller="Client" asp-action="MyAppointments" class="btn btn-outline-glass btn-lg px-5">
                            <i class="bi bi-calendar-check me-2"></i>Mis Reservas
                        </a>
                    }
                    else if (User.IsInRole("Barber"))
                    {
                        <a asp-controller="Barber" asp-action="Dashboard" class="btn btn-primary btn-lg px-5">
                            <i class="bi bi-speedometer2 me-2"></i>Ir a mi Dashboard
                        </a>
                    }
                    else if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-primary btn-lg px-5">
                            <i class="bi bi-speedometer2 me-2"></i>Panel de Administración
                        </a>
                    }
                </div>
                <div class="d-flex flex-wrap gap-4 justify-content-center justify-content-lg-start mt-5">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-primary"></i>
                        <span class="small">Sin tarjeta de crédito</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-primary"></i>
                        <span class="small">7 días de prueba gratis</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-primary"></i>
                        <span class="small">Soporte 24/7</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block">
                <div class="position-relative">
                    <div class="floating-card glass-card p-3 position-absolute top-0 start-0 translate-middle-y">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-calendar-check text-primary fs-4"></i>
                            <div>
                                <small class="fw-bold">Nueva reserva</small>
                                <small class="d-block text-muted">Corte de cabello - 15 min</small>
                            </div>
                        </div>
                    </div>
                    <div class="floating-card glass-card p-3 position-absolute top-0 end-0 translate-middle-y">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-whatsapp text-success fs-4"></i>
                            <div>
                                <small class="fw-bold">Recordatorio enviado</small>
                                <small class="d-block text-muted">Confirmación automática</small>
                            </div>
                        </div>
                    </div>
                   
                </div>
                <div class="glass-card p-2 mt-lg-5 hero-dashboard-image">
                    <img src="~/images/logo/Pantalla Master.png" alt="CitaCorte Dashboard" class="img-fluid rounded-4 w-100">
                </div>
            </div>
        </div>
    </div>
</section>

