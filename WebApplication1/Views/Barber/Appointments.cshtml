@model List<WebApplication1.Models.Appointment>
@{
    ViewData["Title"] = "Todas las Citas";
    var selectedDate = (DateTime)ViewData["SelectedDate"];
}

<div class="row mb-4">
    <div class="col-md-8">
        <h2><i class="bi bi-calendar-check"></i> Todas las Citas</h2>
        <p class="text-muted">Gestiona todas tus citas</p>
    </div>
    <div class="col-md-4 text-end">
        <a asp-controller="Barber" asp-action="Dashboard" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver al Dashboard
        </a>
    </div>
</div>

<!-- Date Filter -->
<div class="row mb-4">
    <div class="col-md-6">
        <form asp-controller="Barber" asp-action="Appointments" method="get" class="d-flex gap-2">
            <input type="date" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" class="form-control" />
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Filtrar
            </button>
            <a asp-controller="Barber" asp-action="Appointments" class="btn btn-outline-secondary">
                <i class="bi bi-x-circle"></i> Hoy
            </a>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th>Cliente</th>
                            <th>Servicio</th>
                            <th>Fecha</th>
                            <th>Hora</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@appt.Client.FullName</strong>
                                    <br />
                                    <small class="text-muted">@appt.Client.Email</small>
                                </td>
                                <td>@appt.Service.Name</td>
                                <td>@appt.Date.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge bg-primary">@appt.Time.ToString(@"hh\:mm")</span></td>
                                <td>
                                    @{
                                        var badgeClass = appt.Status switch
                                        {
                                            WebApplication1.Models.AppointmentStatus.Pending => "bg-warning text-dark",
                                            WebApplication1.Models.AppointmentStatus.Confirmed => "bg-info",
                                            WebApplication1.Models.AppointmentStatus.InProgress => "bg-primary",
                                            WebApplication1.Models.AppointmentStatus.Completed => "bg-success",
                                            WebApplication1.Models.AppointmentStatus.Cancelled => "bg-secondary",
                                            _ => "bg-secondary"
                                        };
                                        var statusText = appt.Status switch
                                        {
                                            WebApplication1.Models.AppointmentStatus.Pending => "Pendiente",
                                            WebApplication1.Models.AppointmentStatus.Confirmed => "Confirmada",
                                            WebApplication1.Models.AppointmentStatus.InProgress => "En Progreso",
                                            WebApplication1.Models.AppointmentStatus.Completed => "Completada",
                                            WebApplication1.Models.AppointmentStatus.Cancelled => "Cancelada",
                                            _ => "Desconocido"
                                        };
                                    }
                                    <span class="badge @badgeClass">@statusText</span>
                                </td>
                                <td>
                                    @if (appt.Status == WebApplication1.Models.AppointmentStatus.Pending)
                                    {
                                        <form asp-controller="Barber" asp-action="UpdateAppointmentStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@appt.Id" />
                                            <input type="hidden" name="status" value="Confirmed" />
                                            <button class="btn btn-sm btn-success" title="Confirmar">
                                                <i class="bi bi-check-lg"></i> Confirmar
                                            </button>
                                        </form>
                                    }
                                    @if (appt.Status == WebApplication1.Models.AppointmentStatus.Confirmed)
                                    {
                                        <form asp-controller="Barber" asp-action="UpdateAppointmentStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@appt.Id" />
                                            <input type="hidden" name="status" value="InProgress" />
                                            <button class="btn btn-sm btn-primary" title="Iniciar">
                                                <i class="bi bi-play-fill"></i> Iniciar
                                            </button>
                                        </form>
                                    }
                                    @if (appt.Status == WebApplication1.Models.AppointmentStatus.InProgress)
                                    {
                                        <form asp-controller="Barber" asp-action="UpdateAppointmentStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@appt.Id" />
                                            <input type="hidden" name="status" value="Completed" />
                                            <button class="btn btn-sm btn-success" title="Completar">
                                                <i class="bi bi-check-circle"></i> Completar
                                            </button>
                                        </form>
                                    }
                                    @if (appt.Status != WebApplication1.Models.AppointmentStatus.Cancelled && appt.Status != WebApplication1.Models.AppointmentStatus.Completed)
                                    {
                                        <form asp-controller="Barber" asp-action="UpdateAppointmentStatus" method="post" class="d-inline ms-1">
                                            <input type="hidden" name="id" value="@appt.Id" />
                                            <input type="hidden" name="status" value="Cancelled" />
                                            <button class="btn btn-sm btn-outline-danger" title="Cancelar" onclick="return confirm('¿Cancelar esta cita?')">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-calendar-x text-muted" style="font-size: 4rem;"></i>
        <h4 class="text-muted mt-3">No hay citas para esta fecha</h4>
        <p class="text-muted">Selecciona otra fecha o vuelve al dashboard</p>
    </div>
}
