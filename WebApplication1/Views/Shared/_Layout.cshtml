<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="CitaCorte - Sistema profesional de reservaciones para barberías" />
    <title>@ViewData["Title"] | CitaCorte</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" type="image/x-icon" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo/Isotipo.png" alt="CitaCorte" class="navbar-logo-isotipo" />
                    <img src="~/images/logo/Logotipo.png" alt="CitaCorte" class="navbar-logo-text" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i>
                                <span>Inicio</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Booking" asp-action="Index">
                                <i class="bi bi-search"></i>
                                <span>Barberos</span>
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-speedometer2"></i>
                                    <span>Admin</span>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Barber"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Barber" asp-action="Dashboard">
                                    <i class="bi bi-briefcase"></i>
                                    <span>Mi Barbería</span>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Client"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Client" asp-action="MyAppointments">
                                    <i class="bi bi-calendar-check"></i>
                                    <span>Mis Reservas</span>
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown" id="notifications-dropdown">
                                <button class="btn btn-link nav-link position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="notification-bell">
                                    <i class="bi bi-bell"></i>
                                    <span class="position-absolute top-2 start-100 translate-middle badge rounded-pill bg-danger d-none" id="notification-badge">
                                        0
                                    </span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow glass-card" style="min-width: 350px;" id="notifications-menu">
                                    <li class="dropdown-header d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-bell me-1"></i>Notificaciones</span>
                                        <a href="#" class="small text-decoration-none" onclick="markAllAsRead(); return false;">Marcar todas como leídas</a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li id="notifications-loading" class="text-center py-3">
                                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                    </li>
                                    <li id="notifications-list" class="d-none">
                                        <!-- Notifications will be loaded here -->
                                    </li>
                                    <li id="notifications-empty" class="d-none text-center py-3">
                                        <small class="text-muted">No hay notificaciones nuevas</small>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li class="text-center">
                                        <a asp-controller="Notifications" asp-action="Index" class="dropdown-item small">Ver todas las notificaciones</a>
                                    </li>
                                </ul>
                            </li>
                        }
                        <li class="nav-item">
                            <button id="theme-toggle" class="btn btn-link nav-link" aria-label="Cambiar tema">
                                <i id="theme-icon" class="bi bi-moon-stars"></i>
                            </button>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
        </nav>
    </header>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <div class="row g-4 py-5">
                <!-- Columna 1: Brand & Descripción -->
                <div class="col-lg-4 col-md-6 mb-4 mb-lg-0">
                    <div class="d-flex align-items-center gap-2 mb-3 footer-brand">
                        <img src="~/images/logo/Isotipo.png" alt="CitaCorte" class="footer-logo-isotipo" />
                        <img src="~/images/logo/Logotipo.png" alt="CitaCorte" class="footer-logo-text" />
                    </div>
                    <p class="small text-secondary mb-3">
                        La plataforma moderna para reservar y gestionar barberías. Tecnología de punta para potenciar tu negocio.
                    </p>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-secondary-hover" aria-label="Facebook"><i class="bi bi-facebook fs-5"></i></a>
                        <a href="#" class="text-secondary-hover" aria-label="Instagram"><i class="bi bi-instagram fs-5"></i></a>
                        <a href="#" class="text-secondary-hover" aria-label="WhatsApp"><i class="bi bi-whatsapp fs-5"></i></a>
                        <a href="#" class="text-secondary-hover" aria-label="TikTok"><i class="bi bi-tiktok fs-5"></i></a>
                    </div>
                </div>

                <!-- Columna 2: Enlaces rápidos -->
                <div class="col-lg-2 col-md-6 mb-4 mb-lg-0">
                    <h6 class="fw-bold mb-3 footer-heading">Producto</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-controller="Booking" asp-action="Index" class="text-decoration-none footer-link">Reservar</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Features" class="text-decoration-none footer-link">Características</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Pricing" class="text-decoration-none footer-link">Precios</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Testimonials" class="text-decoration-none footer-link">Testimonios</a></li>
                    </ul>
                </div>

                <!-- Columna 3: Soporte -->
                <div class="col-lg-2 col-md-6 mb-4 mb-lg-0">
                    <h6 class="fw-bold mb-3 footer-heading">Soporte</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Help" class="text-decoration-none footer-link">Centro de ayuda</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Contact" class="text-decoration-none footer-link">Contacto</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Privacy" class="text-decoration-none footer-link">Privacidad</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Terms" class="text-decoration-none footer-link">Términos</a></li>
                    </ul>
                </div>

                <!-- Columna 4: Newsletter / Contacto -->
                <div class="col-lg-4 col-md-6 mb-4 mb-lg-0">
                    <h6 class="fw-bold mb-3 footer-heading">Suscríbete</h6>
                    <p class="small text-secondary mb-3">Recibe novedades y ofertas exclusivas.</p>
                    <div class="input-group mb-2">
                        <input type="email" class="form-control form-control-sm bg-transparent border-secondary" placeholder="Tu correo electrónico">
                        <button class="btn btn-primary btn-sm" type="button">
                            <i class="bi bi-send"></i>
                        </button>
                    </div>
                    <p class="small text-muted mb-0">Promociones, nuevos barberos y mucho más.</p>
                </div>
            </div>

            <!-- Línea divisoria y copyright -->
            <div class="row pt-4 pb-3 border-top border-secondary-subtle">
                <div class="col-12 text-center">
                    <p class="mb-0 small text-secondary d-flex align-items-center justify-content-center gap-2">
                        <img src="~/images/logo/Icono.png" alt="CitaCorte" class="footer-icon" />
                        <span><strong>CitaCorte</strong> &copy; @DateTime.Now.Year. Todos los derechos reservados.</span>
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
