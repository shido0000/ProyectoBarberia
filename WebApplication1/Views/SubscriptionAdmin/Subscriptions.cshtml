@model List<WebApplication1.Models.Subscription>
@{
    ViewData["Title"] = "Suscripciones Activas";
}

<!-- Page Header with Animation -->
<div class="admin-header-section mb-5 animate-fade-in-down">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="icon-wrapper">
                        <div class="bg-gradient-primary rounded-circle d-inline-flex align-items-center justify-content-center shadow-glow" style="width: 64px; height: 64px;">
                            <i class="bi bi-credit-card-2-front text-white" style="font-size: 1.75rem;"></i>
                        </div>
                    </div>
                    <div>
                        <h1 class="display-6 fw-bold mb-1 gradient-text">Suscripciones Activas</h1>
                        <p class="text-muted mb-0">Gestiona las suscripciones de los barberos</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a asp-controller="SubscriptionAdmin" asp-action="Assign" class="btn btn-primary btn-lg btn-animated shadow-glow">
                    <i class="bi bi-plus-circle"></i> Nueva Suscripción
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Alert Messages -->
@if (TempData["Success"] != null)
{
    <div class="container mb-4">
        <div class="alert alert-success alert-custom alert-dismissible fade show animate-fade-in-up" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <span>@TempData["Success"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<div class="container pb-5">
    @if (Model.Any())
    {
        <!-- Stats Cards -->
        <div class="row g-4 mb-5">
            <div class="col-md-3 col-6">
                <div class="stat-card glass-card animate-fade-in-up" style="animation-delay: 0.1s;">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="stat-value text-primary mb-1">@Model.Count</div>
                            <div class="stat-label">Total</div>
                        </div>
                        <div class="stat-icon bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                            <i class="bi bi-card-list fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card glass-card animate-fade-in-up" style="animation-delay: 0.2s;">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="stat-value text-success mb-1">@Model.Count(s => s.IsActive && (!s.EndDate.HasValue || s.EndDate.Value > DateTime.Now))</div>
                            <div class="stat-label">Activas</div>
                        </div>
                        <div class="stat-icon bg-success bg-opacity-10 text-success rounded-3 p-3">
                            <i class="bi bi-check-circle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card glass-card animate-fade-in-up" style="animation-delay: 0.3s;">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="stat-value text-warning mb-1">@Model.Count(s => s.EndDate.HasValue && s.EndDate.Value <= DateTime.Now)</div>
                            <div class="stat-label">Vencidas</div>
                        </div>
                        <div class="stat-icon bg-warning bg-opacity-10 text-warning rounded-3 p-3">
                            <i class="bi bi-exclamation-circle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card glass-card animate-fade-in-up" style="animation-delay: 0.4s;">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="stat-value text-danger mb-1">@Model.Count(s => !s.IsActive)</div>
                            <div class="stat-label">Inactivas</div>
                        </div>
                        <div class="stat-icon bg-danger bg-opacity-10 text-danger rounded-3 p-3">
                            <i class="bi bi-x-circle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Table Card -->
        <div class="glass-card border-0 shadow-md animate-fade-in-up" style="animation-delay: 0.5s;">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="bg-gradient-primary text-white">
                            <tr>
                                <th class="ps-4"><i class="bi bi-person me-2"></i>Barbero</th>
                                <th><i class="bi bi-layers me-2"></i>Plan</th>
                                <th><i class="bi bi-calendar-event me-2"></i>Inicio</th>
                                <th><i class="bi bi-calendar-x me-2"></i>Fin</th>
                                <th><i class="bi bi-toggle-on me-2"></i>Estado</th>
                                <th class="text-center pe-4"><i class="bi bi-gear me-2"></i>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sub in Model)
                            {
                                var isActive = sub.IsActive && (!sub.EndDate.HasValue || sub.EndDate.Value > DateTime.Now);
                                var isExpired = sub.EndDate.HasValue && sub.EndDate.Value <= DateTime.Now;
                                
                                <tr class="@(isActive ? "" : "table-secondary")">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                                <i class="bi bi-person-fill fs-5"></i>
                                            </div>
                                            <div>
                                                <strong class="d-block">@sub.User.FullName</strong>
                                                <small class="text-muted">@sub.User.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (sub.SubscriptionPlan != null)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2">
                                                <i class="bi bi-star me-1"></i>@sub.SubscriptionPlan.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary px-3 py-2">
                                                <i class="bi bi-tag me-1"></i>Plan personalizado
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-calendar-check text-success"></i>
                                            <span>@sub.StartDate.ToString("dd/MM/yyyy")</span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (sub.EndDate.HasValue)
                                        {
                                            <div class="d-flex align-items-center gap-2 @(isExpired ? "text-danger" : "")">
                                                <i class="bi bi-calendar-x @(isExpired ? "text-danger" : "text-muted")"></i>
                                                <span>@sub.EndDate.Value.ToString("dd/MM/yyyy")</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted"><i class="bi bi-infinity me-1"></i>Sin fecha</span>
                                        }
                                    </td>
                                    <td>
                                        @if (isActive)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2">
                                                <i class="bi bi-check-circle-fill me-1"></i>Activa
                                            </span>
                                        }
                                        else if (isExpired)
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning px-3 py-2">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>Vencida
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary px-3 py-2">
                                                <i class="bi bi-pause-circle-fill me-1"></i>Inactiva
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center pe-4">
                                        @if (sub.IsActive && !isExpired)
                                        {
                                            <form asp-controller="SubscriptionAdmin" asp-action="CancelSubscription" asp-route-id="@sub.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger btn-animated" 
                                                        onclick="return confirm('¿Cancelar esta suscripción?')">
                                                    <i class="bi bi-x-circle me-1"></i>Cancelar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i class="bi bi-lock"></i> No disponible</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="glass-card p-5 text-center animate-fade-in-up">
            <div class="bg-gradient-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-4 mx-auto shadow-glow" style="width: 140px; height: 140px;">
                <i class="bi bi-credit-card text-white" style="font-size: 4rem;"></i>
            </div>
            <h4 class="fw-bold mb-2 gradient-text">No hay suscripciones activas</h4>
            <p class="text-muted mb-4">Asigna un plan a un barbero para empezar</p>
            <a asp-controller="SubscriptionAdmin" asp-action="Assign" class="btn btn-primary btn-lg btn-animated shadow-glow">
                <i class="bi bi-plus-circle me-2"></i>Asignar Suscripción
            </a>
        </div>
    }
</div>
