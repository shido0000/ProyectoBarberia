@model WebApplication1.Models.SubscriptionPlan
@{
    ViewData["Title"] = "Editar Plan de Suscripción";
}

<div class="row mb-4 section-header">
    <div class="col-12">
        <h2 class="fw-bold mb-2 text-gradient">
            <i class="bi bi-pencil me-2"></i>Editar Plan de Suscripción
        </h2>
        <p class="text-muted mb-0">Modifica la información del plan</p>
    </div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-md border-0">
            <div class="card-header bg-theme-primary text-theme-inverse">
                <h5 class="mb-0"><i class="bi bi-layers me-2"></i>Información del Plan</h5>
            </div>
            <div class="card-body">
                <form asp-controller="SubscriptionAdmin" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display: none">
                        <i class="bi bi-exclamation-circle me-2"></i>
                        <span></span>
                    </div>
                    
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-bold">
                                <i class="bi bi-tag text-primary me-1"></i> Nombre del Plan
                            </label>
                            <input asp-for="Name" class="form-control form-control-lg" placeholder="Ej: Premium" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TargetType" class="form-label fw-bold">
                                <i class="bi bi-person-badge text-primary me-1"></i> Tipo de Suscriptor
                            </label>
                            <select asp-for="TargetType" class="form-select form-select-lg" asp-items="Html.GetEnumSelectList<SubscriptionTargetType>()" required></select>
                            <span asp-validation-for="TargetType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DurationDays" class="form-label fw-bold">
                                <i class="bi bi-calendar text-primary me-1"></i> Duración (días)
                            </label>
                            <input asp-for="DurationDays" type="number" class="form-control form-control-lg" min="1" required />
                            <span asp-validation-for="DurationDays" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-bold">
                                <i class="bi bi-chat-text text-primary me-1"></i> Descripción
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe este plan..."></textarea>
                        </div>
                    
                    <hr class="my-4" />
                    
                    <h5 class="fw-bold mb-3"><i class="bi bi-currency-dollar text-success me-2"></i>Precios</h5>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="MonthlyPrice" class="form-label fw-bold">
                                <i class="bi bi-calendar-month text-success me-1"></i> Precio Mensual
                            </label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text">$</span>
                                <input asp-for="MonthlyPrice" type="number" step="0.01" min="0" class="form-control" required />
                            </div>
                            <span asp-validation-for="MonthlyPrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AnnualPrice" class="form-label fw-bold">
                                <i class="bi bi-calendar-year text-success me-1"></i> Precio Anual (Opcional)
                            </label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text">$</span>
                                <input asp-for="AnnualPrice" type="number" step="0.01" min="0" class="form-control" placeholder="Opcional" />
                            </div>
                            <span asp-validation-for="AnnualPrice" class="text-danger small"></span>
                        </div>
                    
                    <hr class="my-4" />
                    
                    <h5 class="fw-bold mb-3"><i class="bi bi-sliders text-primary me-2"></i>Límites</h5>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="MaxBarbers" class="form-label fw-bold">
                                <i class="bi bi-people text-primary me-1"></i> Máximo de Barberos
                            </label>
                            <input asp-for="MaxBarbers" type="number" class="form-control form-control-lg" placeholder="Dejar vacío para ilimitado" min="1" />
                            <small class="text-muted">Dejar vacío para ilimitados</small>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MaxServicesPerBarber" class="form-label fw-bold">
                                <i class="bi bi-scissors text-primary me-1"></i> Máx. Servicios por Barbero
                            </label>
                            <input asp-for="MaxServicesPerBarber" type="number" class="form-control form-control-lg" placeholder="Dejar vacío para ilimitado" min="1" />
                            <small class="text-muted">Dejar vacío para ilimitados</small>
                        </div>
                    
                    <hr class="my-4" />
                    
                    <h5 class="fw-bold mb-3"><i class="bi bi-check2-square text-primary me-2"></i>Características Principales</h5>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="CanReceiveBookings" class="form-check-input" />
                                <label asp-for="CanReceiveBookings" class="form-check-label fw-semibold">
                                    <i class="bi bi-calendar-check text-primary me-1"></i> Recibir Reservas
                                </label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input asp-for="CanAccessAnalytics" class="form-check-input" />
                                <label asp-for="CanAccessAnalytics" class="form-check-label fw-semibold">
                                    <i class="bi bi-bar-chart text-primary me-1"></i> Analytics
                                </label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input asp-for="CanAccessAccounting" class="form-check-input" />
                                <label asp-for="CanAccessAccounting" class="form-check-label fw-semibold">
                                    <i class="bi bi-cash-coin text-primary me-1"></i> Contabilidad
                                </label>
                            </div>
                            <div class="form-check form-switch">
                                <input asp-for="CanAccessInventory" class="form-check-input" />
                                <label asp-for="CanAccessInventory" class="form-check-label fw-semibold">
                                    <i class="bi bi-box-seam text-primary me-1"></i> Inventario
                                </label>
                            </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="CanPostProducts" class="form-check-input" />
                                <label asp-for="CanPostProducts" class="form-check-label fw-semibold">
                                    <i class="bi bi-shop text-primary me-1"></i> Postear Productos
                                </label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input asp-for="CanUseBanners" class="form-check-input" />
                                <label asp-for="CanUseBanners" class="form-check-label fw-semibold">
                                    <i class="bi bi-image text-primary me-1"></i> Banners
                                </label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input asp-for="PrioritySupport" class="form-check-input" />
                                <label asp-for="PrioritySupport" class="form-check-label fw-semibold">
                                    <i class="bi bi-headset text-primary me-1"></i> Soporte Prioritario
                                </label>
                            </div>
                            <div class="form-check form-switch">
                                <input asp-for="IncludeAnalytics" class="form-check-input" />
                                <label asp-for="IncludeAnalytics" class="form-check-label fw-semibold">
                                    <i class="bi bi-bar-chart-line text-primary me-1"></i> Include Analytics (Legacy)
                                </label>
                            </div>
                    </div>
                    
                    <hr class="my-4" />
                    
                    <h5 class="fw-bold mb-3 text-muted"><i class="bi bi-archive me-2"></i>Características Legacy</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input asp-for="CustomBranding" class="form-check-input" />
                                <label asp-for="CustomBranding" class="form-check-label">Branding Personalizado</label>
                            </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input asp-for="AutoReminders" class="form-check-input" />
                                <label asp-for="AutoReminders" class="form-check-label">Recordatorios</label>
                            </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input asp-for="ExportReports" class="form-check-input" />
                                <label asp-for="ExportReports" class="form-check-label">Exportar Reportes</label>
                            </div>
                    </div>
                    
                    <hr class="my-4" />
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label fw-semibold">
                                    <i class="bi bi-check-circle text-success me-1"></i> Plan Activo
                                </label>
                            </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input asp-for="IsDefault" class="form-check-input" />
                                <label asp-for="IsDefault" class="form-check-label fw-semibold">
                                    <i class="bi bi-star text-warning me-1"></i> Plan por Defecto
                                </label>
                            </div>
                    </div>
                    
                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-primary btn-lg flex-grow-1 shadow">
                            <i class="bi bi-check-circle"></i> Guardar Cambios
                        </button>
                        <a asp-controller="SubscriptionAdmin" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
    </div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
