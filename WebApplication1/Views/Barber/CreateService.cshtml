@model WebApplication1.Models.ViewModels.ServiceViewModel
@{
    ViewData["Title"] = "Crear Servicio";
}

<!-- Page Header with Animation -->
<div class="container py-4 animate-fade-in-down">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Decorative Header Card -->
            <div class="glass-card p-4 mb-4 text-center">
                <div class="icon-wrapper mb-3">
                    <div class="bg-gradient-primary rounded-circle d-inline-flex align-items-center justify-content-center shadow-glow" style="width: 90px; height: 90px;">
                        <i class="bi bi-plus-circle text-white" style="font-size: 3rem;"></i>
                    </div>
                </div>
                <h2 class="fw-bold mb-2 gradient-text">Crear Nuevo Servicio</h2>
                <p class="text-muted mb-0">Agrega un nuevo servicio a tu oferta</p>
            </div>

            <!-- Form Card -->
            <div class="glass-card shadow-2xl border-0 animate-fade-in-up">
                <div class="card-body p-5">
                    <form asp-controller="Barber" asp-action="CreateService" method="post" class="auth-form">
                        @{
                            var hasErrors = ViewData.ModelState.ErrorCount > 0;
                            var displayStyle = hasErrors ? "flex" : "none";
                        }
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-custom mb-4" role="alert" style="display: @displayStyle">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            <span></span>
                        </div>

                        <div class="mb-4 form-group-animated">
                            <label asp-for="Name" class="form-label fw-semibold">
                                <i class="bi bi-tag text-primary me-2"></i>Nombre del Servicio *
                            </label>
                            <div class="input-group-animated">
                                <input asp-for="Name" class="form-control form-control-lg" placeholder="Ej: Corte de Cabello" required autofocus />
                                <div class="input-icon">
                                    <i class="bi bi-tag"></i>
                                </div>
                            </div>
                            <span asp-validation-for="Name" class="text-danger small mt-1"></span>
                        </div>

                        <div class="mb-4 form-group-animated">
                            <label asp-for="Description" class="form-label fw-semibold">
                                <i class="bi bi-chat-text text-primary me-2"></i>Descripción
                            </label>
                            <div class="input-group-animated">
                                <textarea asp-for="Description" class="form-control form-control-lg" rows="4" placeholder="Describe brevemente el servicio..."></textarea>
                                <div class="input-icon">
                                    <i class="bi bi-chat-text"></i>
                                </div>
                            </div>
                            <span asp-validation-for="Description" class="text-danger small mt-1"></span>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <div class="form-group-animated">
                                    <label asp-for="Price" class="form-label fw-semibold">
                                        <i class="bi bi-currency-dollar text-primary me-2"></i>Precio *
                                    </label>
                                    <div class="input-group-animated input-group-lg">
                                        <span class="input-group-text bg-glass border-end-0">
                                            <i class="bi bi-currency-dollar"></i>
                                        </span>
                                        <input asp-for="Price" type="number" step="0.01" min="0" class="form-control border-start-0" placeholder="0.00" required />
                                    </div>
                                    <span asp-validation-for="Price" class="text-danger small mt-1"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group-animated">
                                    <label asp-for="DurationMinutes" class="form-label fw-semibold">
                                        <i class="bi bi-clock text-primary me-2"></i>Duración (minutos) *
                                    </label>
                                    <div class="input-group-animated">
                                        <input asp-for="DurationMinutes" type="number" min="5" class="form-control form-control-lg" placeholder="30" required />
                                        <div class="input-icon">
                                            <i class="bi bi-clock"></i>
                                        </div>
                                    </div>
                                    <span asp-validation-for="DurationMinutes" class="text-danger small mt-1"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-3 flex-column flex-sm-row">
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1 shadow-glow btn-animated">
                                <i class="bi bi-check-circle me-2"></i>Crear Servicio
                            </button>
                            <a asp-controller="Barber" asp-action="Services" class="btn btn-outline-glass btn-lg">
                                <i class="bi bi-x-circle me-2"></i>Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Animaciones adicionales al cargar
        document.addEventListener('DOMContentLoaded', function () {
            const inputs = document.querySelectorAll('.form-control, textarea');
            inputs.forEach(input => {
                input.addEventListener('focus', function () {
                    this.parentElement.classList.add('focused');
                });
                input.addEventListener('blur', function () {
                    if (!this.value) {
                        this.parentElement.classList.remove('focused');
                    }
                });
            });
        });
    </script>
}