@model List<WebApplication1.Models.ApplicationUser>
@{
    ViewData["Title"] = "Gestión de Clientes";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h2><i class="bi bi-person-check"></i> Gestión de Clientes</h2>
        <p class="text-muted">Administra todos los clientes registrados</p>
    </div>
    <div class="col-md-4 text-end">
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="bg-success text-white">
                    <tr>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Teléfono</th>
                        <th>Fecha de Registro</th>
                        <th>Total Reservas</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model)
                    {
                        <tr>
                            <td><strong>@client.FullName</strong></td>
                            <td>@client.Email</td>
                            <td>@(client.PhoneNumber ?? "-")</td>
                            <td>@client.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge bg-info">@client.ClientAppointments.Count</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
