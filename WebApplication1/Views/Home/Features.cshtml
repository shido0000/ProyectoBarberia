@{
    ViewData["Title"] = "Características";
}

<div class="container py-5">
    <!-- Header -->
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h1 class="display-5 fw-bold mb-3">
                <i class="bi bi-stars me-2" style="color: var(--primary);"></i>
                Características de la Plataforma
            </h1>
            <p class="lead text-secondary">
                Todo lo que necesitas para una experiencia de reservación excepcional
            </p>
        </div>
    </div>

    <!-- Características Principales -->
    <div class="row g-4 mb-5">
        <!-- Búsqueda Avanzada -->
        <div class="col-md-6 col-lg-4">
            <div class="feature-card h-100">
                <div class="feature-icon">
                    <i class="bi bi-search"></i>
                </div>
                <h4 class="fw-bold mb-3">Búsqueda Inteligente</h4>
                <ul class="list-unstyled text-secondary">
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Filtrar por ubicación geográfica</span>
                    </li>
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Buscar por especialidad (cortes, barba, color)</span>
                    </li>
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Ordenar por calificación y precio</span>
                    </li>
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Ver disponibilidad en tiempo real</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Agendamiento 24/7 -->
        <div class="col-md-6 col-lg-4">
            <div class="feature-card h-100">
                <div class="feature-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <h4 class="fw-bold mb-3">Agendamiento 24/7</h4>
                <ul class="list-unstyled text-secondary">
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Reserva citas en cualquier momento</span>
                    </li>
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Calendario interactivo con horarios disponibles</span>
                    </li>
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Confirmación inmediata de reserva</span>
                    </li>
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Posibilidad de agendar con anticipación</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Recordatorios Automáticos -->
        <div class="col-md-6 col-lg-4">
            <div class="feature-card h-100">
                <div class="feature-icon">
                    <i class="bi bi-bell-fill"></i>
                </div>
                <h4 class="fw-bold mb-3">Recordatorios Automáticos</h4>
                <ul class="list-unstyled text-secondary">
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Notificaciones por email antes de tu cita</span>
                    </li>
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Alertas personalizables (24h, 2h antes)</span>
                    </li>
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Reducción de inasistencias</span>
                    </li>
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Recordatorios de seguimiento post-cita</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Historial de Citas -->
        <div class="col-md-6 col-lg-4">
            <div class="feature-card h-100">
                <div class="feature-icon">
                    <i class="bi bi-clock-history"></i>
                </div>
                <h4 class="fw-bold mb-3">Historial Completo</h4>
                <ul class="list-unstyled text-secondary">
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Acceso a todas tus citas pasadas</span>
                    </li>
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Detalle de servicios recibidos</span>
                    </li>
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Reagendar citas anteriores fácilmente</span>
                    </li>
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Exportar historial para referencia personal</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Calificaciones y Reseñas -->
        <div class="col-md-6 col-lg-4">
            <div class="feature-card h-100">
                <div class="feature-icon">
                    <i class="bi bi-star-fill"></i>
                </div>
                <h4 class="fw-bold mb-3">Sistema de Calificaciones</h4>
                <ul class="list-unstyled text-secondary">
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Califica con 1-5 estrellas</span>
                    </li>
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Deja comentarios detallados</span>
                    </li>
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Lee opiniones de otros clientes</span>
                    </li>
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Ayuda a mantener la calidad del servicio</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Reserva de Productos -->
        <div class="col-md-6 col-lg-4">
            <div class="feature-card h-100">
                <div class="feature-icon">
                    <i class="bi bi-bag-fill"></i>
                </div>
                <h4 class="fw-bold mb-3">Reserva de Productos</h4>
                <ul class="list-unstyled text-secondary">
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Productos de cuidado capilar y de barba</span>
                    </li>
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Reservar para recoger en tienda</span>
                    </li>
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Control de inventario en tiempo real</span>
                    </li>
                    <li class="mb-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2 text-success mt-1"></i>
                        <span>Recomendaciones personalizadas</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Sección Secundaria -->
    <div class="row g-4 mb-5">
        <div class="col-12">
            <h2 class="fw-bold mb-4 text-center">Más Beneficios para Ti</h2>
        </div>

        <div class="col-md-6">
            <div class="glass-card p-4 d-flex gap-3">
                <div class="flex-shrink-0">
                    <div class="rounded-circle bg-primary-subtle d-flex align-items-center justify-content-center" 
                         style="width: 56px; height: 56px;">
                        <i class="bi bi-person-badge fs-3 text-primary"></i>
                    </div>
                </div>
                <div>
                    <h5 class="fw-bold mb-2">Perfiles Verificados</h5>
                    <p class="text-secondary mb-0">
                        Todos los barberos y barberías pasan por un proceso de verificación para garantizar tu seguridad y confianza.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="glass-card p-4 d-flex gap-3">
                <div class="flex-shrink-0">
                    <div class="rounded-circle bg-accent-subtle d-flex align-items-center justify-content-center" 
                         style="width: 56px; height: 56px;">
                        <i class="bi bi-shield-check fs-3" style="color: var(--accent);"></i>
                    </div>
                </div>
                <div>
                    <h5 class="fw-bold mb-2">Pago Seguro</h5>
                    <p class="text-secondary mb-0">
                        Transacciones protegidas con encriptación de última generación. Opción de señas para reservas especiales.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="glass-card p-4 d-flex gap-3">
                <div class="flex-shrink-0">
                    <div class="rounded-circle bg-success-subtle d-flex align-items-center justify-content-center" 
                         style="width: 56px; height: 56px;">
                        <i class="bi bi-heart fs-3 text-success"></i>
                    </div>
                </div>
                <div>
                    <h5 class="fw-bold mb-2">Barberos Favoritos</h5>
                    <p class="text-secondary mb-0">
                        Guarda tus barberos favoritos para acceder rápidamente y recibir notificaciones de sus disponibilidades.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="glass-card p-4 d-flex gap-3">
                <div class="flex-shrink-0">
                    <div class="rounded-circle bg-warning-subtle d-flex align-items-center justify-content-center" 
                         style="width: 56px; height: 56px;">
                        <i class="bi bi-gift fs-3" style="color: var(--warning);"></i>
                    </div>
                </div>
                <div>
                    <h5 class="fw-bold mb-2">Promociones Exclusivas</h5>
                    <p class="text-secondary mb-0">
                        Accede a ofertas especiales, descuentos y promociones de temporada directamente desde tu cuenta.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Section -->
    <div class="row g-4 mt-5 pt-4">
        <div class="col-12 text-center mb-4">
            <h2 class="fw-bold">¿Por qué elegir BarberShop Pro?</h2>
            <p class="text-secondary">Números que respaldan nuestra calidad</p>
        </div>
        
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-number">500+</div>
                <div class="stat-label">Barberos</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-number">50K+</div>
                <div class="stat-label">Citas Mensuales</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-number">4.8</div>
                <div class="stat-label">Calificación Promedio</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-number">98%</div>
                <div class="stat-label">Clientes Satisfechos</div>
            </div>
        </div>
    </div>

    <!-- CTA Final -->
    <div class="row mt-5 pt-4">
        <div class="col-12">
            <div class="glass-card p-5 text-center" style="background: linear-gradient(135deg, var(--primary-glow), var(--accent-glow));">
                <h3 class="fw-bold mb-3">¿Listo para experimentar la diferencia?</h3>
                <p class="lead text-secondary mb-4">
                    Únete a miles de clientes satisfechos y descubre la mejor manera de cuidar tu estilo.
                </p>
                <div class="d-flex gap-3 justify-content-center flex-wrap">
                    <a asp-controller="Booking" asp-action="Index" class="btn btn-primary btn-lg">
                        <i class="bi bi-search me-2"></i>Buscar Barberos
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-glass btn-lg">
                        <i class="bi bi-person-plus me-2"></i>Crear Cuenta Gratis
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .feature-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-glow);
        }
        
        .stat-card:hover {
            transform: scale(1.05);
        }
        
        .bg-accent-subtle {
            background-color: rgba(124, 58, 237, 0.15) !important;
        }
    </style>
}
