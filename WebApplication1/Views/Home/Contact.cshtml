@{
    ViewData["Title"] = "Contacto";
}

<div class="container py-5">
    <!-- Header -->
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h1 class="display-5 fw-bold mb-3">
                <i class="bi bi-envelope-fill me-2" style="color: var(--primary);"></i>
                Contáctanos
            </h1>
            <p class="lead text-secondary">
                ¿Tienes preguntas? Estamos aquí para ayudarte
            </p>
        </div>
    </div>

    <div class="row g-5">
        <!-- Formulario de Contacto -->
        <div class="col-lg-7">
            <div class="glass-card p-4 p-md-5">
                <h3 class="fw-bold mb-4">Envíanos un mensaje</h3>
                
                <form asp-action="Contact" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="firstName" class="form-label">Nombre *</label>
                            <input type="text" class="form-control" id="firstName" name="firstName" required>
                        </div>
                        <div class="col-md-6">
                            <label for="lastName" class="form-label">Apellido</label>
                            <input type="text" class="form-control" id="lastName" name="lastName">
                        </div>
                        
                        <div class="col-12">
                            <label for="email" class="form-label">Correo electrónico *</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                        </div>
                        
                        <div class="col-12">
                            <label for="phone" class="form-label">Teléfono</label>
                            <input type="tel" class="form-control" id="phone" name="phone">
                        </div>
                        
                        <div class="col-12">
                            <label for="subject" class="form-label">Asunto *</label>
                            <select class="form-select" id="subject" name="subject" required>
                                <option value="">Selecciona un asunto...</option>
                                <option value="general">Consulta General</option>
                                <option value="soporte">Soporte Técnico</option>
                                <option value="ventas">Ventas y Suscripciones</option>
                                <option value="partnership">Alianzas Comerciales</option>
                                <option value="reporte">Reportar Problema</option>
                                <option value="otro">Otro</option>
                            </select>
                        </div>
                        
                        <div class="col-12">
                            <label for="message" class="form-label">Mensaje *</label>
                            <textarea class="form-control" id="message" name="message" rows="5" required 
                                      placeholder="Describe tu consulta o problema con el mayor detalle posible..."></textarea>
                        </div>
                        
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="privacy" name="privacy" required>
                                <label class="form-check-label" for="privacy">
                                    Acepto la <a asp-controller="Home" asp-action="Privacy" class="text-primary">Política de Privacidad</a> *
                                </label>
                            </div>
                        </div>
                        
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg w-100">
                                <i class="bi bi-send me-2"></i>Enviar Mensaje
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Información de Contacto -->
        <div class="col-lg-5">
            <div class="mb-4">
                <h3 class="fw-bold mb-4">Información de Contacto</h3>
                
                <div class="d-flex gap-3 mb-4">
                    <div class="flex-shrink-0">
                        <div class="rounded-circle bg-primary-subtle d-flex align-items-center justify-content-center" 
                             style="width: 50px; height: 50px;">
                            <i class="bi bi-geo-alt-fill fs-4 text-primary"></i>
                        </div>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Dirección</h6>
                        <p class="text-secondary mb-0">Calle Principal #123<br>Ciudad, País CP 00000</p>
                    </div>
                </div>

                <div class="d-flex gap-3 mb-4">
                    <div class="flex-shrink-0">
                        <div class="rounded-circle bg-success-subtle d-flex align-items-center justify-content-center" 
                             style="width: 50px; height: 50px;">
                            <i class="bi bi-telephone-fill fs-4 text-success"></i>
                        </div>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Teléfono</h6>
                        <p class="text-secondary mb-0">
                            <a href="tel:+15551234567" class="text-decoration-none">+1 (555) 123-4567</a><br>
                            <small>Lunes a Viernes, 9am - 6pm</small>
                        </p>
                    </div>
                </div>

                <div class="d-flex gap-3 mb-4">
                    <div class="flex-shrink-0">
                        <div class="rounded-circle bg-accent-subtle d-flex align-items-center justify-content-center" 
                             style="width: 50px; height: 50px;">
                            <i class="bi bi-envelope-fill fs-4" style="color: var(--accent);"></i>
                        </div>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Correo Electrónico</h6>
                        <p class="text-secondary mb-0">
                            <a href="mailto:info@barbershoppro.com" class="text-decoration-none">info&#64;barbershoppro.com</a><br>
                            <a href="mailto:soporte@barbershoppro.com" class="text-decoration-none">soporte&#64;barbershoppro.com</a>
                        </p>
                    </div>
                </div>

                <hr class="my-4" />

                <h6 class="fw-bold mb-3">Síguenos en Redes Sociales</h6>
                <div class="d-flex gap-3">
                    <a href="#" class="btn btn-outline-glass" aria-label="Facebook">
                        <i class="bi bi-facebook"></i>
                    </a>
                    <a href="#" class="btn btn-outline-glass" aria-label="Instagram">
                        <i class="bi bi-instagram"></i>
                    </a>
                    <a href="#" class="btn btn-outline-glass" aria-label="Twitter">
                        <i class="bi bi-twitter-x"></i>
                    </a>
                    <a href="#" class="btn btn-outline-glass" aria-label="LinkedIn">
                        <i class="bi bi-linkedin"></i>
                    </a>
                    <a href="#" class="btn btn-outline-glass" aria-label="YouTube">
                        <i class="bi bi-youtube"></i>
                    </a>
                </div>
            </div>

            <!-- Mapa (placeholder) -->
            <div class="glass-card p-3">
                <div class="rounded overflow-hidden" style="height: 250px; background: var(--bg-tertiary);">
                    <iframe 
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3168.639290621062!2d-122.08374688469227!3d37.42199997982461!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x808fba02425dad8f%3A0x2c246f2d803746f3!2sGoogleplex!5e0!3m2!1ses!2sus!4v1234567890" 
                        width="100%" 
                        height="100%" 
                        style="border:0; filter: grayscale(1) contrast(1.2) opacity(0.8);" 
                        allowfullscreen="" 
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
                <small class="text-muted d-block mt-2 text-center">
                    <i class="bi bi-geo-alt me-1"></i>Nuestra ubicación principal
                </small>
            </div>
        </div>
    </div>

    <!-- FAQ Rápida -->
    <div class="row mt-5 pt-4">
        <div class="col-12">
            <h3 class="fw-bold mb-4 text-center">Preguntas Frecuentes</h3>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="glass-card p-4 h-100">
                        <h6 class="fw-bold mb-2">
                            <i class="bi bi-question-circle me-2" style="color: var(--primary);"></i>
                            ¿Cuál es el tiempo de respuesta?
                        </h6>
                        <p class="text-secondary small mb-0">
                            Respondemos todas las consultas dentro de las 24-48 horas hábiles. Para soporte urgente, usa el chat en vivo.
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="glass-card p-4 h-100">
                        <h6 class="fw-bold mb-2">
                            <i class="bi bi-question-circle me-2" style="color: var(--primary);"></i>
                            ¿Ofrecen soporte en español?
                        </h6>
                        <p class="text-secondary small mb-0">
                            Sí, nuestro equipo de soporte habla español e inglés. También tenemos documentación en ambos idiomas.
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="glass-card p-4 h-100">
                        <h6 class="fw-bold mb-2">
                            <i class="bi bi-question-circle me-2" style="color: var(--primary);"></i>
                            ¿Cómo puedo reportar un bug?
                        </h6>
                        <p class="text-secondary small mb-0">
                            Usa este formulario seleccionando "Reportar Problema" como asunto. Incluye detalles y capturas si es posible.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .bg-accent-subtle {
            background-color: rgba(124, 58, 237, 0.15) !important;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 0.25rem var(--primary-glow);
        }
        
        .btn-outline-glass:hover {
            background: var(--primary);
            border-color: var(--primary);
            color: white;
        }
    </style>
}

@section Scripts {
    <script>
        // Validación simple del formulario
        document.querySelector('form').addEventListener('submit', function(e) {
            const email = document.getElementById('email').value;
            const message = document.getElementById('message').value;
            
            if (!email || !email.includes('@@')) {
                e.preventDefault();
                alert('Por favor ingresa un correo electrónico válido.');
                return false;
            }
            
            if (!message || message.length < 10) {
                e.preventDefault();
                alert('El mensaje debe tener al menos 10 caracteres.');
                return false;
            }
        });
    </script>
}
