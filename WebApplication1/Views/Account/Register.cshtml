@model WebApplication1.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Crear Cuenta";
}

<div class="row justify-content-center py-5">
    <div class="col-sm-10 col-md-8 col-lg-7 col-xl-6">
        <div class="card shadow-xl border-0">
            <div class="card-body p-5">
                <div class="text-center mb-5">
                    <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px;">
                        <i class="bi bi-person-plus text-success" style="font-size: 3.5rem;"></i>
                    </div>
                    <h2 class="fw-bold mb-2">Crear Cuenta</h2>
                    <p class="text-muted">Únete a BarberShop Pro</p>
                </div>
                
                <form asp-action="Register" method="post">
                    @{
                        var hasErrors = ViewData.ModelState.ErrorCount > 0;
                        var displayStyle = hasErrors ? "flex" : "none";
                    }
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display: @displayStyle">
                        <i class="bi bi-exclamation-circle"></i>
                        <span></span>
                    </div>
                    
                    <div class="mb-4">
                        <label asp-for="FullName" class="form-label">
                            <i class="bi bi-person text-primary me-2"></i> Nombre Completo
                        </label>
                        <input asp-for="FullName" class="form-control form-control-lg" placeholder="Juan Pérez" autofocus />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    
                    <div class="mb-4">
                        <label asp-for="Email" class="form-label">
                            <i class="bi bi-envelope text-primary me-2"></i> Email
                        </label>
                        <input asp-for="Email" type="email" class="form-control form-control-lg" placeholder="tu@email.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    
                    <div class="mb-4">
                        <label asp-for="Password" class="form-label">
                            <i class="bi bi-lock text-primary me-2"></i> Contraseña
                        </label>
                        <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="Mínimo 6 caracteres" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label">
                            <i class="bi bi-lock-fill text-primary me-2"></i> Confirmar Contraseña
                        </label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control form-control-lg" placeholder="Repite tu contraseña" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    
                    <div class="mb-4">
                        <label asp-for="Role" class="form-label">
                            <i class="bi bi-briefcase text-primary me-2"></i> Tipo de Usuario
                        </label>
                        <select asp-for="Role" class="form-select form-select-lg">
                            <option value="">-- Selecciona una opción --</option>
                            <option value="Client">🙋 Cliente - Quiero reservar citas</option>
                            <option value="Barber">💈 Barbero - Quiero ofrecer servicios</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>
                    
                    <button type="submit" class="btn btn-primary btn-lg w-100 mb-4 shadow-glow">
                        <i class="bi bi-check-circle"></i> Crear Cuenta
                    </button>
                </form>
                
                <div class="text-center">
                    <p class="mb-0 text-muted">¿Ya tienes cuenta?</p>
                    <a asp-action="Login" class="btn btn-outline-primary btn-lg w-100">
                        <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
