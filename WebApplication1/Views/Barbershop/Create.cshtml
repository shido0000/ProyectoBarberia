@model WebApplication1.Models.Barbershop

@{
    ViewData["Title"] = "Crear Barbería";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card glass-card">
                <div class="card-body p-4 p-md-5">
                    <h1 class="display-6 fw-bold mb-4 text-center">
                        <i class="bi bi-shop me-2"></i>Crear Nueva Barbería
                    </h1>
                    
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" placeholder="Ej: Barbería El Clásico" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe tu barbería..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label"></label>
                            <input asp-for="Address" class="form-control" placeholder="Dirección completa" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" placeholder="Teléfono de contacto" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="LogoUrl" class="form-label"></label>
                            <input asp-for="LogoUrl" class="form-control" placeholder="URL del logo" />
                            <small class="text-muted">Pega la URL de una imagen para el logo</small>
                            <span asp-validation-for="LogoUrl" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="CoverImageUrl" class="form-label"></label>
                            <input asp-for="CoverImageUrl" class="form-control" placeholder="URL de imagen de portada" />
                            <small class="text-muted">Pega la URL de una imagen para la portada</small>
                            <span asp-validation-for="CoverImageUrl" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-4">
                            <label asp-for="BarbershopSubscriptionPlanId" class="form-label"></label>
                            <select asp-for="BarbershopSubscriptionPlanId" class="form-select">
                                <option value="">Selecciona un plan</option>
                                @foreach (var plan in ViewBag.Plans as List<WebApplication1.Models.BarbershopSubscriptionPlan>)
                                {
                                    <option value="@plan.Id">@plan.Name - $@plan.MonthlyPrice/mes @(plan.MaxBarbers.HasValue ? $"(Máx {plan.MaxBarbers} barberos)" : "(Barberos ilimitados)")</option>
                                }
                            </select>
                            <span asp-validation-for="BarbershopSubscriptionPlanId" class="text-danger"></span>
                            <small class="text-muted">El administrador puede cambiar el plan más tarde</small>
                        </div>
                        
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-1"></i>Crear Barbería
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
<style>
    .glass-card {
        background: var(--glass-bg);
        backdrop-filter: blur(10px);
        border: 1px solid var(--border-color);
        border-radius: 1rem;
    }
</style>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
