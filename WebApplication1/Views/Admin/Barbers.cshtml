@model List<WebApplication1.Models.ApplicationUser>
@{
    ViewData["Title"] = "Gestión de Barberos";
}

<!-- Header Section -->
<div class="container py-4">
    <div class="row mb-4 align-items-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                    <i class="bi bi-people text-primary fs-4"></i>
                </div>
                <div>
                    <h1 class="display-6 fw-bold mb-1 gradient-text">Gestión de Barberos</h1>
                    <p class="text-muted mb-0">Administra todos los barberos registrados en la plataforma</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-glass">
                <i class="bi bi-arrow-left me-2"></i>Volver al Panel
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show animate-fade-in-up" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <span>@TempData["Success"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stats Summary -->
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="glass-card p-3 text-center">
                <div class="stat-number" style="font-size: 2rem;">@Model.Count</div>
                <div class="stat-label">Total Barberos</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="glass-card p-3 text-center">
                <div class="stat-number text-success" style="font-size: 2rem;">@Model.Count(b => b.BarberProfile?.IsActive == true)</div>
                <div class="stat-label">Activos</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="glass-card p-3 text-center">
                <div class="stat-number text-danger" style="font-size: 2rem;">@Model.Count(b => b.BarberProfile?.IsActive != true)</div>
                <div class="stat-label">Inactivos</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="glass-card p-3 text-center">
                <div class="stat-number text-info" style="font-size: 2rem;">@Model.Count(b => !string.IsNullOrEmpty(b.BarberProfile?.ShopName))</div>
                <div class="stat-label">Con Barbería</div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="glass-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-gradient-primary text-white">
                        <tr>
                            <th class="ps-4">Barbero</th>
                            <th>Email</th>
                            <th>Barbería</th>
                            <th>Dirección</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var barber in Model)
                        {
                            var isActive = barber.BarberProfile?.IsActive == true;
                            <tr class="animate-fade-in">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; flex-shrink: 0;">
                                            <i class="bi bi-person-circle text-primary fs-5"></i>
                                        </div>
                                        <div>
                                            <strong class="d-block">@barber.FullName</strong>
                                            <small class="text-muted">ID: @barber.Id.Substring(0, 8)...</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-envelope text-muted small"></i>
                                        <span>@barber.Email</span>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(barber.BarberProfile?.ShopName))
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2">
                                            <i class="bi bi-shop me-1"></i>@barber.BarberProfile.ShopName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><i class="bi bi-dash-circle me-1"></i>Sin configurar</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(barber.BarberProfile?.Address))
                                    {
                                        <span class="text-secondary small"><i class="bi bi-geo-alt me-1"></i>@barber.BarberProfile.Address</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (isActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                                            <i class="bi bi-check-circle-fill me-1"></i>Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 rounded-pill">
                                            <i class="bi bi-x-circle-fill me-1"></i>Inactivo
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <form asp-controller="Admin" asp-action="ToggleBarberStatus" method="post" class="d-inline">
                                        <input type="hidden" name="userId" value="@barber.Id" />
                                        <input type="hidden" name="isActive" value="@((!isActive).ToString().ToLower())" />
                                        @if (isActive)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-danger btn-hover-lift" onclick="return confirm('¿Estás seguro de desactivar este barbero?')">
                                                <i class="bi bi-lock me-1"></i>Desactivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success btn-hover-lift">
                                                <i class="bi bi-unlock me-1"></i>Activar
                                            </button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 96px; height: 96px;">
                <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
            </div>
            <h4 class="text-muted">No hay barberos registrados</h4>
            <p class="text-muted">Los barberos aparecerán aquí una vez que se registren en la plataforma.</p>
        </div>
    }
</div>
