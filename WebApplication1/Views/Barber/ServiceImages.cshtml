@model List<WebApplication1.Models.ServiceImage>
@{
    ViewData["Title"] = "Fotos del Servicio";
    var serviceId = ViewBag.ServiceId;
    var serviceName = ViewBag.ServiceName;
}

<!-- Page Header with Animation -->
<div class="container py-4 animate-fade-in-down">
    <div class="row align-items-center mb-4">
        <div class="col-md-8">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-gradient-primary rounded-circle d-inline-flex align-items-center justify-content-center shadow-glow" style="width: 70px; height: 70px;">
                    <i class="bi bi-camera text-white" style="font-size: 2.5rem;"></i>
                </div>
                <div>
                    <h2 class="fw-bold mb-1 gradient-text">Fotos del Servicio</h2>
                    <p class="text-muted mb-0">Agrega fotos para mostrar ejemplos de "@serviceName"</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a asp-controller="Barber" asp-action="Services" class="btn btn-outline-glass btn-animated">
                <i class="bi bi-arrow-left me-2"></i>Volver a Servicios
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-custom alert-dismissible fade show animate-fade-in-up" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-custom alert-dismissible fade show animate-fade-in-up" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Upload Form -->
    <div class="glass-card shadow-2xl border-0 mb-4 animate-fade-in-up">
        <div class="card-body p-5">
            <h5 class="fw-bold mb-4 gradient-text">
                <i class="bi bi-upload me-2"></i>Subir Nueva Foto
            </h5>
            <form asp-controller="Barber" asp-action="UploadServiceImage" method="post" enctype="multipart/form-data" class="auth-form">
                <input type="hidden" name="serviceId" value="@serviceId" />
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="form-group-animated">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-image text-primary me-2"></i>Seleccionar Imagen
                            </label>
                            <div class="input-group-animated">
                                <input type="file" name="imageFile" class="form-control form-control-lg" accept="image/*" required id="serviceImageInput" />
                                <div class="input-icon">
                                    <i class="bi bi-image"></i>
                                </div>
                            </div>
                            <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Formatos: JPG, PNG, GIF, WEBP. Máximo 5MB</small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group-animated">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-chat-text text-primary me-2"></i>Descripción (Opcional)
                            </label>
                            <div class="input-group-animated">
                                <input type="text" name="description" class="form-control form-control-lg" placeholder="Ej: Resultado final" maxlength="200" />
                                <div class="input-icon">
                                    <i class="bi bi-chat-text"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div id="serviceImagePreview" class="d-none mb-4">
                            <img id="servicePreviewImg" src="" alt="Preview" class="img-thumbnail shadow-sm" style="max-height: 250px;" />
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg w-100 shadow-glow btn-animated">
                            <i class="bi bi-cloud-upload me-2"></i>Subir Foto
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Images Gallery -->
    @if (Model.Any())
    {
        <div class="row g-4 animate-fade-in-up">
            @foreach (var image in Model)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="glass-card shadow-2xl hover-lift animate-fade-in">
                        <div class="position-relative overflow-hidden rounded-top-3">
                            <img src="@image.ImageUrl" alt="@image.Description" class="card-img-top"
                                 style="height: 220px; object-fit: cover; cursor: pointer;"
                                 data-bs-toggle="modal" data-bs-target="#serviceImageModal"
                                 data-image="@image.ImageUrl"
                                 data-description="@image.Description" />
                            <div class="image-overlay"></div>
                        </div>
                        <div class="card-body p-3">
                            @if (!string.IsNullOrEmpty(image.Description))
                            {
                                <p class="small text-muted mb-3 text-truncate" title="@image.Description">@image.Description</p>
                            }
                            <form asp-controller="Barber" asp-action="DeleteServiceImage" method="post">
                                <input type="hidden" name="imageId" value="@image.Id" />
                                <input type="hidden" name="serviceId" value="@serviceId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100 btn-animated"
                                        onclick="return confirm('¿Eliminar esta foto?')">
                                    <i class="bi bi-trash me-1"></i>Eliminar
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="glass-card p-5 text-center animate-fade-in-up">
            <div class="bg-gradient-light rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 120px; height: 120px;">
                <i class="bi bi-camera text-muted" style="font-size: 4rem;"></i>
            </div>
            <h4 class="fw-bold mb-2 gradient-text">No hay fotos para este servicio</h4>
            <p class="text-muted mb-4">Agrega fotos para mostrar ejemplos del trabajo realizado</p>
        </div>
    }
</div>

<!-- Image Modal -->
<div class="modal fade" id="serviceImageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-card border-0">
            <div class="modal-body p-0">
                <img id="serviceModalImage" src="" alt="" class="img-fluid w-100 rounded-top-3" />
                <div class="p-4">
                    <p id="serviceModalDescription" class="mb-0 fw-bold"></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Image preview
        document.getElementById('serviceImageInput').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('servicePreviewImg').src = e.target.result;
                    document.getElementById('serviceImagePreview').classList.remove('d-none');
                };
                reader.readAsDataURL(file);
            }
        });

        // Image modal
        var serviceModal = document.getElementById('serviceImageModal');
        serviceModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var imageUrl = button.getAttribute('data-image');
            var description = button.getAttribute('data-description');

            document.getElementById('serviceModalImage').src = imageUrl;
            document.getElementById('serviceModalDescription').textContent = description || 'Sin descripción';
        });
    </script>
}