@model WebApplication1.Models.ViewModels.ServiceViewModel
@{
    ViewData["Title"] = "Crear Servicio";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-plus-circle"></i> Crear Nuevo Servicio</h4>
            </div>
            <div class="card-body">
                <form asp-controller="Barber" asp-action="CreateService" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>
                    
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">
                            <i class="bi bi-tag"></i> Nombre del Servicio *
                        </label>
                        <input asp-for="Name" class="form-control form-control-lg" placeholder="Ej: Corte de Cabello" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold">
                            <i class="bi bi-chat-text"></i> Descripción
                        </label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe brevemente el servicio..."></textarea>
                    </div>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-bold">
                                <i class="bi bi-currency-dollar"></i> Precio *
                            </label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text">$</span>
                                <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" required />
                            </div>
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DurationMinutes" class="form-label fw-bold">
                                <i class="bi bi-clock"></i> Duración (minutos) *
                            </label>
                            <input asp-for="DurationMinutes" type="number" min="5" class="form-control form-control-lg" placeholder="30" required />
                            <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                            <i class="bi bi-check-circle"></i> Crear Servicio
                        </button>
                        <a asp-controller="Barber" asp-action="Services" class="btn btn-outline-secondary btn-lg">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
