@using Microsoft.AspNetCore.Identity
@using WebApplication1.Models

@if (User.Identity?.IsAuthenticated ?? false)
{
    <ul class="navbar-nav">
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle"></i>
                <span class="d-none d-md-inline">@User.Identity.Name</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                @if (User.IsInRole("Client"))
                {
                    <li>
                        <a class="dropdown-item" asp-controller="Client" asp-action="Profile">
                            <i class="bi bi-person"></i> Mi Perfil
                        </a>
                    </li>
                }
                @if (User.IsInRole("Barber"))
                {
                    <li>
                        <a class="dropdown-item" asp-controller="Barber" asp-action="Profile">
                            <i class="bi bi-person-gear"></i> Mi Perfil
                        </a>
                    </li>
                }
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form class="dropdown-item" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-link p-0 text-danger w-100 text-start">
                            <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" asp-controller="Account" asp-action="Login">
                <i class="bi bi-box-arrow-in-right"></i>
                <span class="d-none d-md-inline">Iniciar Sesión</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Account" asp-action="Register">
                <i class="bi bi-person-plus"></i>
                <span class="d-none d-md-inline">Registrarse</span>
            </a>
        </li>
    </ul>
}
