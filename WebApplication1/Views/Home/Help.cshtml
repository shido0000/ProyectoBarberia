                                                    <li>Fecha de inicio y fin de publicación</li>
                                                    <li>Prioridad de visualización</li>
                                                </ul>
                                            </li>
                                            <li>Selecciona dónde se mostrará (home, booking, etc.).</li>
                                            <li>Activa/desactiva según necesites.</li>
                                            <li>Monitorea clicks y rendimiento.</li>
                                        </ol>
                                    </div>
                                </div>
                            </div>

                            <!-- Testimonios -->
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#admin-collapse3">
