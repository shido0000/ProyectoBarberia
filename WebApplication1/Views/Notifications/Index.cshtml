@model IEnumerable<WebApplication1.Models.Notification>

@{
    ViewData["Title"] = "Notificaciones";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5 fw-bold mb-3">
                <i class="bi bi-bell me-2"></i>Notificaciones
            </h1>
            <p class="text-secondary">Todas tus notificaciones del sistema</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card glass-card">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-bell-slash display-1 text-muted"></i>
                    <h4 class="mt-3">No hay notificaciones</h4>
                    <p class="text-muted">Cuando tengas notificaciones, aparecerán aquí</p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var notification in Model)
                    {
                        <div class="list-group-item @(notification.IsRead ? "" : "bg-primary bg-opacity-10") border-bottom">
                            <div class="d-flex w-100 justify-content-between align-items-start gap-3">
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        @if (notification.Type == NotificationType.NewMembershipRequest)
                                        {
                                            <i class="bi bi-person-plus text-primary"></i>
                                        }
                                        else if (notification.Type == NotificationType.RequestAccepted)
                                        {
                                            <i class="bi bi-check-circle text-success"></i>
                                        }
                                        else if (notification.Type == NotificationType.RequestRejected)
                                        {
                                            <i class="bi bi-x-circle text-danger"></i>
                                        }
                                        else if (notification.Type == NotificationType.BarberLeft)
                                        {
                                            <i class="bi bi-box-arrow-right text-warning"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-info-circle text-secondary"></i>
                                        }
                                        
                                        <p class="mb-0 @(notification.IsRead ? "text-muted" : "fw-semibold")">
                                            @notification.Message
                                        </p>
                                    </div>
                                    <small class="text-muted">@notification.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                
                                @if (!string.IsNullOrEmpty(notification.RelatedUrl))
                                {
                                    <a href="@notification.RelatedUrl" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Back Button -->
    <div class="row mt-4">
        <div class="col-12">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Volver al Inicio
            </a>
        </div>
    </div>
</div>

@section Styles {
<style>
    .glass-card {
        background: var(--glass-bg);
        backdrop-filter: blur(10px);
        border: 1px solid var(--border-color);
        border-radius: 1rem;
    }
    
    .list-group-item {
        background: transparent !important;
    }
</style>
}
