@model WebApplication1.Models.ViewModels.BarberListViewModel
@{
    ViewData["Title"] = "Buscar Barberos";
}

<!-- Page Header -->
<div class="container py-5">
    <div class="row mb-5 align-items-center">
        <div class="col-12 text-center text-md-start">
            <div class="d-inline-block p-3 rounded-4 bg-primary-subtle mb-3 shadow-sm animate-float">
                <i class="bi bi-search fs-3 text-primary"></i>
            </div>
            <h2 class="fw-bold display-6 mb-2 text-gradient">
                Buscar Barberos
            </h2>
            <p class="text-secondary lead mb-0">Encuentra el estilo perfecto cerca de ti</p>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="row justify-content-center mb-5">
        <div class="col-lg-8 col-xl-6">
            <div class="card border-0 shadow-lg card-glass animate-slide-up">
                <div class="card-body p-2">
                    <form asp-action="Index" method="get" class="d-flex gap-2">
                        <div class="position-relative flex-grow-1">
                            <span class="position-absolute top-50 start-0 translate-middle-y ms-3 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" name="searchTerm" value="@Model.SearchTerm" 
                                   class="form-control form-control-lg ps-5 border-0 bg-body-tertiary" 
                                   placeholder="¿Qué estás buscando? (Nombre, ubicación...)" 
                                   aria-label="Buscar barberos" />
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg px-4 shadow-sm">
                            <span class="d-none d-sm-inline">Buscar</span>
                            <i class="bi bi-arrow-right d-sm-none"></i>
                        </button>
                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <a asp-action="Index" class="btn btn-outline-danger btn-lg" title="Limpiar búsqueda">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Barbers.Any())
    {
        <div class="row g-4 justify-content-center">
            @foreach (var barber in Model.Barbers)
            {
                <div class="col-sm-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-hover card-modern transition-all animate-scale-in">
                        <!-- Image Section -->
                        <div class="position-relative overflow-hidden" style="height: 240px;">
                            @if (barber.Images.Any())
                            {
                                var mainImage = barber.Images.FirstOrDefault(i => i.IsMain) ?? barber.Images.First();
                                <img src="@mainImage.ImageUrl" alt="@barber.ShopName" 
                                     class="card-img-top h-100 w-100 object-fit-cover hover-scale" />
                            }
                            else
                            {
                                <div class="card-img-top h-100 w-100 d-flex align-items-center justify-content-center bg-gradient-primary text-white">
                                    <i class="bi bi-person-badge display-1 opacity-75"></i>
                                </div>
                            }
                            <div class="position-absolute top-0 end-0 m-3">
                                <span class="badge bg-white text-dark shadow-sm px-3 py-2 rounded-pill">
                                    <i class="bi bi-star-fill text-warning me-1"></i> 5.0
                                </span>
                            </div>
                        </div>

                        <div class="card-body p-4 d-flex flex-column">
                            <h5 class="card-title fw-bold text-truncate mb-2 text-dark" title="@(barber.ShopName ?? "Barbería Sin Nombre")">
                                @(barber.ShopName ?? "Barbería Sin Nombre")
                            </h5>
                            
                            @if (!string.IsNullOrEmpty(barber.Description))
                            {
                                <p class="card-text text-secondary small mb-3 line-clamp-2">@barber.Description</p>
                            }
                            else
                            {
                                <p class="card-text text-secondary small mb-3 fst-italic">Barbería profesional con los mejores servicios.</p>
                            }

                            <div class="mt-auto">
                                <div class="d-flex flex-column gap-2 mb-3">
                                    @if (!string.IsNullOrEmpty(barber.Address))
                                    {
                                        <div class="d-flex align-items-center text-secondary small">
                                            <i class="bi bi-geo-alt-fill text-primary me-2 fs-5"></i> 
                                            <span class="text-truncate" title="@barber.Address">@barber.Address</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(barber.Phone))
                                    {
                                        <div class="d-flex align-items-center text-secondary small">
                                            <i class="bi bi-telephone-fill text-primary me-2 fs-5"></i> 
                                            <span>@barber.Phone</span>
                                        </div>
                                    }
                                </div>

                                <div class="d-flex justify-content-between align-items-center p-3 rounded-3 bg-body-tertiary mb-3 border border-dashed">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-clock-history text-primary me-2 fs-5"></i>
                                        <div class="lh-1">
                                            <small class="text-muted d-block" style="font-size: 0.7rem;">Horario</small>
                                            <span class="fw-semibold small">@barber.StartTime.ToString(@"hh\:mm") - @barber.EndTime.ToString(@"hh\:mm")</span>
                                        </div>
                                    </div>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3">
                                        @barber.Services.Count(s => s.IsActive) Servicios
                                    </span>
                                </div>

                                <a asp-controller="Booking" asp-action="Barber" asp-route-id="@barber.Id"
                                   class="btn btn-primary w-100 py-2 fw-semibold shadow-sm btn-modern">
                                    <i class="bi bi-calendar-check me-2"></i> Reservar Cita
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center py-5">
                <div class="card border-0 shadow-sm p-5 bg-body-tertiary animate-bounce-in">
                    <div class="mb-4">
                        <div class="avatar-upload mx-auto mb-4">
                            <div class="rounded-circle bg-primary-subtle d-inline-flex align-items-center justify-content-center shadow-inner" style="width: 120px; height: 120px;">
                                <i class="bi bi-search text-primary" style="font-size: 3.5rem;"></i>
                            </div>
                        </div>
                        <h3 class="fw-bold text-dark mb-2">No encontramos resultados</h3>
                        <p class="text-secondary mb-4">
                            @if (!string.IsNullOrEmpty(Model.SearchTerm))
                            {
                                <span>No hay barberos que coincidan con "<strong>@Model.SearchTerm</strong>"</span>
                            }
                            else
                            {
                                <span>Aún no hay barberos registrados en la plataforma.</span>
                            }
                        </p>
                        
                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <a asp-action="Index" class="btn btn-outline-primary btn-lg rounded-pill px-5">
                                <i class="bi bi-arrow-left me-2"></i> Ver todos los barberos
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
