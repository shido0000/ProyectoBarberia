@model WebApplication1.Models.ViewModels.BarberDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Dashboard Header -->
<div class="row mb-4 section-header">
    <div class="col-12">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div>
                <h2 class="fw-bold mb-1 text-gradient">
                    <i class="bi bi-speedometer2 me-2"></i>Dashboard
                </h2>
                <p class="text-muted mb-0 fs-5">@Model.BarberProfile.ShopName</p>
            </div>
            <div>
                <span class="badge bg-gradient-primary fs-6 px-3 py-2">
                    @if (Model.ActiveSubscription?.SubscriptionPlan != null)
                    {
                        @Model.ActiveSubscription.SubscriptionPlan.Name
                    }
                    else
                    {
                        <text>Plan Gratis</text>
                    }
                </span>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Stats Cards -->
<div class="row g-4 mb-5">
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="stat-icon bg-primary bg-opacity-10 text-primary rounded-3">
                    <i class="bi bi-calendar-day"></i>
                </div>
            </div>
            <div class="stat-value text-primary">@Model.TodayAppointments.Count</div>
            <div class="stat-label">Citas Hoy</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="stat-icon bg-success bg-opacity-10 text-success rounded-3">
                    <i class="bi bi-currency-dollar"></i>
                </div>
            </div>
            <div class="stat-value text-success">$@Model.TotalEarnings.ToString("F0")</div>
            <div class="stat-label">Ganancias Hoy</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="stat-icon bg-info bg-opacity-10 text-info rounded-3">
                    <i class="bi bi-calendar-check"></i>
                </div>
            </div>
            <div class="stat-value text-info">@Model.TotalAppointmentsThisMonth</div>
            <div class="stat-label">Citas del Mes</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="stat-icon bg-warning bg-opacity-10 text-warning rounded-3">
                    <i class="bi bi-scissors"></i>
                </div>
            </div>
            <div class="stat-value text-warning">@Model.Services.Count</div>
            <div class="stat-label">Servicios</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Today's Appointments -->
    <div class="col-lg-8">
        <div class="card shadow-md border-0">
            <div class="card-header bg-gradient-primary text-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="mb-0"><i class="bi bi-calendar-day me-2"></i>Citas de Hoy</h5>
                <a asp-controller="Barber" asp-action="Appointments" class="btn btn-sm btn-light">
                    <i class="bi bi-calendar3 me-1"></i>Ver Todas
                </a>
            </div>
            <div class="card-body p-0">
                @if (Model.TodayAppointments.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var appt in Model.TodayAppointments)
                        {
                            <div class="list-group-item p-4">
                                <div class="row align-items-center g-3">
                                    <div class="col-auto">
                                        <span class="badge bg-primary fs-6 py-3 px-4 rounded-3 shadow">@appt.Time.ToString(@"hh\:mm")</span>
                                    </div>
                                    <div class="col">
                                        <strong class="d-block fs-5">@appt.Client.FullName</strong>
                                        <small class="text-muted">@appt.Service.Name • @appt.Service.DurationMinutes min</small>
                                    </div>
                                    <div class="col-auto">
                                        @{
                                            var badgeClass = appt.Status switch
                                            {
                                                WebApplication1.Models.AppointmentStatus.Pending => "bg-warning text-dark",
                                                WebApplication1.Models.AppointmentStatus.Confirmed => "bg-info",
                                                WebApplication1.Models.AppointmentStatus.InProgress => "bg-primary",
                                                WebApplication1.Models.AppointmentStatus.Completed => "bg-success",
                                                WebApplication1.Models.AppointmentStatus.Cancelled => "bg-secondary",
                                                _ => "bg-secondary"
                                            };
                                            var statusText = appt.Status switch
                                            {
                                                WebApplication1.Models.AppointmentStatus.Pending => "Pendiente",
                                                WebApplication1.Models.AppointmentStatus.Confirmed => "Confirmada",
                                                WebApplication1.Models.AppointmentStatus.InProgress => "En Progreso",
                                                WebApplication1.Models.AppointmentStatus.Completed => "Completada",
                                                WebApplication1.Models.AppointmentStatus.Cancelled => "Cancelada",
                                                _ => "Desconocido"
                                            };
                                        }
                                        <span class="badge @badgeClass d-block mb-2 px-3 py-2">@statusText</span>
                                    </div>
                                    <div class="col-auto">
                                        <div class="btn-group" role="group">
                                            @if (appt.Status == WebApplication1.Models.AppointmentStatus.Pending)
                                            {
                                                <form asp-controller="Barber" asp-action="UpdateAppointmentStatus" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@appt.Id" />
                                                    <input type="hidden" name="status" value="Confirmed" />
                                                    <button class="btn btn-success" title="Confirmar">
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                </form>
                                            }
                                            @if (appt.Status == WebApplication1.Models.AppointmentStatus.Confirmed)
                                            {
                                                <form asp-controller="Barber" asp-action="UpdateAppointmentStatus" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@appt.Id" />
                                                    <input type="hidden" name="status" value="InProgress" />
                                                    <button class="btn btn-primary" title="Iniciar">
                                                        <i class="bi bi-play-fill"></i>
                                                    </button>
                                                </form>
                                            }
                                            @if (appt.Status == WebApplication1.Models.AppointmentStatus.InProgress)
                                            {
                                                <form asp-controller="Barber" asp-action="UpdateAppointmentStatus" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@appt.Id" />
                                                    <input type="hidden" name="status" value="Completed" />
                                                    <button class="btn btn-success" title="Completar">
                                                        <i class="bi bi-check-circle"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3 mx-auto" style="width: 120px; height: 120px;">
                            <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
                        </div>
                        <p class="text-muted mb-0">No hay citas para hoy</p>
                    </div>
                }
            </div>
        </div>
    </div>
    
    <!-- Quick Links -->
    <div class="col-lg-4">
        <div class="card shadow-md mb-4 border-0">
            <div class="card-header bg-gradient-dark text-white">
                <h6 class="mb-0"><i class="bi bi-lightning me-2"></i>Acciones Rápidas</h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-3">
                    <a asp-controller="Barber" asp-action="Services" class="btn btn-outline-primary btn-lg">
                        <i class="bi bi-scissors"></i> Gestionar Servicios
                    </a>
                    <a asp-controller="Barber" asp-action="Appointments" class="btn btn-outline-primary btn-lg">
                        <i class="bi bi-calendar-check"></i> Ver Todas las Citas
                    </a>
                    <a asp-controller="Barber" asp-action="Profile" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-person-gear"></i> Editar Perfil
                    </a>
                    <a asp-controller="Barber" asp-action="ShopImages" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-camera"></i> Gestionar Fotos
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
