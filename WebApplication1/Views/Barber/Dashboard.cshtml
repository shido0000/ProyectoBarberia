@model WebApplication1.Models.ViewModels.BarberDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Dashboard Header with Modern Design -->
<div class="container py-4 animate-fade-in-up">
    <div class="row mb-5">
        <div class="col-12">
            <div class="glass-card p-4 p-md-5">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-gradient-primary rounded-circle d-flex align-items-center justify-content-center shadow-glow" 
                             style="width: 80px; height: 80px; min-width: 80px;">
                            <i class="bi bi-speedometer2 text-white" style="font-size: 2.5rem;"></i>
                        </div>
                        <div>
                            <h1 class="fw-bold mb-1 gradient-text display-6">Dashboard</h1>
                            <p class="text-muted mb-0 fs-5">@Model.BarberProfile.ShopName</p>
                        </div>
                    </div>
                    <div>
                        <span class="glass-card px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2">
                            <i class="bi bi-patch-check-fill text-primary"></i>
                            @if (Model.ActiveSubscription?.SubscriptionPlan != null)
                            {
                                @Model.ActiveSubscription.SubscriptionPlan.Name
                            }
                            else
                            {
                                <text>Plan Gratis</text>
                            }
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-md animate-fade-in-down" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stats Cards with Glassmorphism -->
    <div class="row g-4 mb-5">
        <div class="col-6 col-lg-3">
            <div class="glass-card stat-card h-100 p-4 animate-fade-in-up" style="animation-delay: 0.1s;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" 
                         style="width: 56px; height: 56px;">
                        <i class="bi bi-calendar-day" style="font-size: 1.5rem;"></i>
                    </div>
                </div>
                <div class="stat-value text-primary fw-bold display-6">@Model.TodayAppointments.Count</div>
                <div class="stat-label text-muted text-uppercase small fw-semibold">Citas Hoy</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="glass-card stat-card h-100 p-4 animate-fade-in-up" style="animation-delay: 0.2s;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="stat-icon bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center" 
                         style="width: 56px; height: 56px;">
                        <i class="bi bi-currency-dollar" style="font-size: 1.5rem;"></i>
                    </div>
                </div>
                <div class="stat-value text-success fw-bold display-6">$@Model.TotalEarnings.ToString("F0")</div>
                <div class="stat-label text-muted text-uppercase small fw-semibold">Ganancias Hoy</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="glass-card stat-card h-100 p-4 animate-fade-in-up" style="animation-delay: 0.3s;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="stat-icon bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center" 
                         style="width: 56px; height: 56px;">
                        <i class="bi bi-calendar-check" style="font-size: 1.5rem;"></i>
                    </div>
                </div>
                <div class="stat-value text-info fw-bold display-6">@Model.TotalAppointmentsThisMonth</div>
                <div class="stat-label text-muted text-uppercase small fw-semibold">Citas del Mes</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="glass-card stat-card h-100 p-4 animate-fade-in-up" style="animation-delay: 0.4s;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="stat-icon bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center" 
                         style="width: 56px; height: 56px;">
                        <i class="bi bi-scissors" style="font-size: 1.5rem;"></i>
                    </div>
                </div>
                <div class="stat-value text-warning fw-bold display-6">@Model.Services.Count</div>
                <div class="stat-label text-muted text-uppercase small fw-semibold">Servicios</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Today's Appointments -->
        <div class="col-lg-8">
            <div class="glass-card border-0 h-100 animate-fade-in-up" style="animation-delay: 0.5s;">
                <div class="card-header bg-transparent border-0 p-4 pb-0">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-calendar-day text-primary me-2"></i>Citas de Hoy
                        </h5>
                        <a asp-controller="Barber" asp-action="Appointments" class="btn btn-animated btn-outline-primary btn-sm">
                            <i class="bi bi-calendar3 me-1"></i>Ver Todas
                        </a>
                    </div>
                </div>
                <div class="card-body p-4">
                    @if (Model.TodayAppointments.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var appt in Model.TodayAppointments)
                            {
                                <div class="list-group-item p-4 mb-3 glass-card border-0 hover-lift">
                                    <div class="row align-items-center g-3">
                                        <div class="col-auto">
                                            <span class="badge bg-gradient-primary fs-6 py-3 px-4 rounded-pill shadow-glow">
                                                @appt.Time.ToString(@"hh\:mm")
                                            </span>
                                        </div>
                                        <div class="col">
                                            <strong class="d-block fs-5 text-primary">@appt.Client.FullName</strong>
                                            <small class="text-muted">
                                                <i class="bi bi-scissors me-1"></i>@appt.Service.Name 
                                                <span class="mx-2">•</span>
                                                <i class="bi bi-clock me-1"></i>@appt.Service.DurationMinutes min
                                            </small>
                                        </div>
                                        <div class="col-auto">
                                            @{
                                                var badgeClass = appt.Status switch
                                                {
                                                    WebApplication1.Models.AppointmentStatus.Pending => "bg-warning text-dark",
                                                    WebApplication1.Models.AppointmentStatus.Confirmed => "bg-info",
                                                    WebApplication1.Models.AppointmentStatus.InProgress => "bg-primary",
                                                    WebApplication1.Models.AppointmentStatus.Completed => "bg-success",
                                                    WebApplication1.Models.AppointmentStatus.Cancelled => "bg-secondary",
                                                    _ => "bg-secondary"
                                                };
                                                var statusIcon = appt.Status switch
                                                {
                                                    WebApplication1.Models.AppointmentStatus.Pending => "bi-clock",
                                                    WebApplication1.Models.AppointmentStatus.Confirmed => "bi-check-circle",
                                                    WebApplication1.Models.AppointmentStatus.InProgress => "bi-play-circle",
                                                    WebApplication1.Models.AppointmentStatus.Completed => "bi-check-all-circle",
                                                    WebApplication1.Models.AppointmentStatus.Cancelled => "bi-x-circle",
                                                    _ => "bi-question-circle"
                                                };
                                                var statusText = appt.Status switch
                                                {
                                                    WebApplication1.Models.AppointmentStatus.Pending => "Pendiente",
                                                    WebApplication1.Models.AppointmentStatus.Confirmed => "Confirmada",
                                                    WebApplication1.Models.AppointmentStatus.InProgress => "En Progreso",
                                                    WebApplication1.Models.AppointmentStatus.Completed => "Completada",
                                                    WebApplication1.Models.AppointmentStatus.Cancelled => "Cancelada",
                                                    _ => "Desconocido"
                                                };
                                            }
                                            <span class="badge @badgeClass d-block mb-2 px-3 py-2 rounded-pill">
                                                <i class="bi @statusIcon me-1"></i>@statusText
                                            </span>
                                        </div>
                                        <div class="col-auto">
                                            <div class="btn-group" role="group">
                                                @if (appt.Status == WebApplication1.Models.AppointmentStatus.Pending)
                                                {
                                                    <form asp-controller="Barber" asp-action="UpdateAppointmentStatus" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@appt.Id" />
                                                        <input type="hidden" name="status" value="Confirmed" />
                                                        <button class="btn btn-success btn-sm" title="Confirmar">
                                                            <i class="bi bi-check-lg"></i>
                                                        </button>
                                                    </form>
                                                }
                                                @if (appt.Status == WebApplication1.Models.AppointmentStatus.Confirmed)
                                                {
                                                    <form asp-controller="Barber" asp-action="UpdateAppointmentStatus" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@appt.Id" />
                                                        <input type="hidden" name="status" value="InProgress" />
                                                        <button class="btn btn-primary btn-sm" title="Iniciar">
                                                            <i class="bi bi-play-fill"></i>
                                                        </button>
                                                    </form>
                                                }
                                                @if (appt.Status == WebApplication1.Models.AppointmentStatus.InProgress)
                                                {
                                                    <form asp-controller="Barber" asp-action="UpdateAppointmentStatus" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@appt.Id" />
                                                        <input type="hidden" name="status" value="Completed" />
                                                        <button class="btn btn-success btn-sm" title="Completar">
                                                            <i class="bi bi-check-circle"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-4 mx-auto" 
                                 style="width: 140px; height: 140px;">
                                <i class="bi bi-calendar-x text-muted" style="font-size: 4rem;"></i>
                            </div>
                            <h5 class="text-muted mb-2">No hay citas para hoy</h5>
                            <p class="text-muted mb-0">Disfruta tu día o prepárate para las próximas reservas</p>
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <!-- Quick Links -->
        <div class="col-lg-4">
            <div class="glass-card border-0 mb-4 animate-fade-in-up" style="animation-delay: 0.6s;">
                <div class="card-header bg-transparent border-0 p-4 pb-0">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-lightning-charge-fill text-warning me-2"></i>Acciones Rápidas
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="d-grid gap-3">
                        <a asp-controller="Barber" asp-action="Services" class="btn btn-animated btn-outline-primary btn-lg">
                            <i class="bi bi-scissors"></i> Gestionar Servicios
                        </a>
                        <a asp-controller="Barber" asp-action="Appointments" class="btn btn-animated btn-outline-primary btn-lg">
                            <i class="bi bi-calendar-check"></i> Ver Todas las Citas
                        </a>
                        <a asp-controller="Barber" asp-action="Profile" class="btn btn-animated btn-outline-secondary btn-lg">
                            <i class="bi bi-person-gear"></i> Editar Perfil
                        </a>
                        <a asp-controller="Barber" asp-action="ShopImages" class="btn btn-animated btn-outline-secondary btn-lg">
                            <i class="bi bi-camera"></i> Gestionar Fotos
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
