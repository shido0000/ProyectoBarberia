                                        <strong>¿Cómo generar reportes del sistema?</strong>
                                    </button>
                                </h2>
                                <div id="admin-collapse5" class="accordion-collapse collapse" data-bs-parent="#accordionAdmin">
                                    <div class="accordion-body">
                                        <ol class="mb-0">
