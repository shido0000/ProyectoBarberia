@model List<WebApplication1.Models.Service>
@{
    ViewData["Title"] = "Mis Servicios";
}

<!-- Page Header with Animation -->
<div class="container py-4 animate-fade-in-down">
    <div class="row align-items-center mb-4">
        <div class="col-md-8">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-gradient-primary rounded-circle d-inline-flex align-items-center justify-content-center shadow-glow" style="width: 70px; height: 70px;">
                    <i class="bi bi-scissors text-white" style="font-size: 2.5rem;"></i>
                </div>
                <div>
                    <h2 class="fw-bold mb-1 gradient-text">Mis Servicios</h2>
                    <p class="text-muted mb-0">Gestiona los servicios que ofreces</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a asp-controller="Barber" asp-action="CreateService" class="btn btn-primary btn-lg shadow-glow btn-animated">
                <i class="bi bi-plus-circle me-2"></i>Nuevo Servicio
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-custom alert-dismissible fade show animate-fade-in-up" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="row g-4 animate-fade-in-up">
            @foreach (var service in Model)
            {
                <div class="col-sm-6 col-lg-4">
                    <div class="glass-card h-100 shadow-2xl hover-lift animate-fade-in">
                        @if (service.Images.Any())
                        {
                            <div class="position-relative overflow-hidden rounded-top-3">
                                <img src="@service.Images.First().ImageUrl" alt="@service.Name"
                                     class="card-img-top" style="height: 200px; object-fit: cover;" />
                                <div class="image-overlay"></div>
                            </div>
                        }
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="card-title fw-bold mb-0 fs-5">@service.Name</h5>
                                <span class="badge bg-gradient-primary px-3 py-2 fs-6">$@service.Price.ToString("F2")</span>
                            </div>

                            @if (!string.IsNullOrEmpty(service.Description))
                            {
                                <p class="card-text text-muted small mb-3 line-clamp-2">@service.Description</p>
                            }

                            <div class="d-flex align-items-center gap-2 mb-4">
                                <i class="bi bi-clock text-primary"></i>
                                <span class="text-muted small">@service.DurationMinutes minutos</span>
                            </div>

                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-controller="Barber" asp-action="ServiceImages" asp-route-serviceId="@service.Id"
                                   class="btn btn-sm btn-outline-info flex-grow-1 btn-animated" title="Gestionar fotos">
                                    <i class="bi bi-camera me-1"></i>Fotos @(service.Images.Count > 0 ? $"({service.Images.Count})" : "")
                                </a>
                                <a asp-controller="Barber" asp-action="EditService" asp-route-id="@service.Id"
                                   class="btn btn-sm btn-outline-primary btn-animated" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-controller="Barber" asp-action="DeleteService" asp-route-id="@service.Id" method="post" class="flex-grow-0">
                                    <button type="submit" class="btn btn-sm btn-outline-danger btn-animated"
                                            onclick="return confirm('¿Eliminar este servicio?')" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="glass-card p-5 text-center animate-fade-in-up">
            <div class="bg-gradient-light rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 120px; height: 120px;">
                <i class="bi bi-scissors text-muted" style="font-size: 4rem;"></i>
            </div>
            <h4 class="fw-bold mb-2 gradient-text">No tienes servicios</h4>
            <p class="text-muted mb-4">Crea tu primer servicio para empezar a recibir reservas</p>
            <a asp-controller="Barber" asp-action="CreateService" class="btn btn-primary btn-lg shadow-glow btn-animated">
                <i class="bi bi-plus-circle me-2"></i>Crear Primer Servicio
            </a>
        </div>
    }
</div>