@model List<WebApplication1.Models.Service>
@{
    ViewData["Title"] = "Mis Servicios";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-2">
            <i class="bi bi-scissors text-primary me-2"></i>Mis Servicios
        </h2>
        <p class="text-muted mb-0">Gestiona los servicios que ofreces</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-controller="Barber" asp-action="CreateService" class="btn btn-primary btn-lg">
            <i class="bi bi-plus-circle me-1"></i> Nuevo Servicio
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Any())
{
    <div class="row g-3 g-md-4">
        @foreach (var service in Model)
        {
            <div class="col-sm-6 col-lg-4">
                <div class="card h-100 shadow-sm hover-lift">
                    @if (service.Images.Any())
                    {
                        <img src="@service.Images.First().ImageUrl" alt="@service.Name" 
                             class="card-img-top" style="height: 180px; object-fit: cover;" />
                    }
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold mb-0">@service.Name</h5>
                            <h4 class="text-primary fw-bold mb-0">$@service.Price.ToString("F2")</h4>
                        </div>

                        @if (!string.IsNullOrEmpty(service.Description))
                        {
                            <p class="card-text text-muted small mb-3">@service.Description</p>
                        }

                        <p class="card-text small mb-3">
                            <i class="bi bi-clock text-primary me-1"></i> @service.DurationMinutes minutos
                        </p>

                        <div class="d-flex gap-2">
                            <a asp-controller="Barber" asp-action="ServiceImages" asp-route-serviceId="@service.Id"
                               class="btn btn-sm btn-outline-info flex-grow-1" title="Gestionar fotos">
                                <i class="bi bi-camera"></i> Fotos @(service.Images.Count > 0 ? $"({service.Images.Count})" : "")
                            </a>
                            <a asp-controller="Barber" asp-action="EditService" asp-route-id="@service.Id"
                               class="btn btn-sm btn-outline-primary flex-grow-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-controller="Barber" asp-action="DeleteService" asp-route-id="@service.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('¿Eliminar este servicio?')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-4 mx-auto" style="width: 120px; height: 120px;">
            <i class="bi bi-scissors text-muted" style="font-size: 4rem;"></i>
        </div>
        <h4 class="text-muted mb-2">No tienes servicios</h4>
        <p class="text-muted mb-4">Crea tu primer servicio para empezar a recibir reservas</p>
        <a asp-controller="Barber" asp-action="CreateService" class="btn btn-primary btn-lg">
            <i class="bi bi-plus-circle me-2"></i>Crear Primer Servicio
        </a>
    </div>
}
