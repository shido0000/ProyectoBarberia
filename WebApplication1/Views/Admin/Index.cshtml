@{
    ViewData["Title"] = "Panel de Administración";
}

<!-- Admin Header with Modern Design -->
<div class="container py-4">
    <div class="row mb-4 align-items-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-gradient-primary rounded-circle d-flex align-items-center justify-content-center shadow-glow" style="width: 64px; height: 64px;">
                    <i class="bi bi-speedometer2 text-white fs-3"></i>
                </div>
                <div>
                    <h1 class="display-6 fw-bold mb-1 gradient-text">Panel de Administración</h1>
                    <p class="text-muted mb-0">Gestiona toda la plataforma BarberShop Pro desde un solo lugar</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-glass">
                <i class="bi bi-house-door me-2"></i>Ir al Inicio
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show animate-fade-in-up" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <span>@TempData["Success"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stats Cards - Enhanced Design -->
    <div class="row g-4 mb-5">
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="bg-primary bg-opacity-10 rounded-4 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                        <i class="bi bi-people text-primary fs-4"></i>
                    </div>
                    <span class="badge bg-primary bg-opacity-10 text-primary">Total</span>
                </div>
                <div class="stat-number">@ViewBag.TotalBarbers</div>
                <div class="stat-label">Barberos Activos</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="bg-success bg-opacity-10 rounded-4 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                        <i class="bi bi-person-check text-success fs-4"></i>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success">Clientes</span>
                </div>
                <div class="stat-number" style="font-size: 2.5rem;">@ViewBag.TotalClients</div>
                <div class="stat-label">Clientes Registrados</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="bg-info bg-opacity-10 rounded-4 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                        <i class="bi bi-calendar-check text-info fs-4"></i>
                    </div>
                    <span class="badge bg-info bg-opacity-10 text-info">Reservas</span>
                </div>
                <div class="stat-number" style="font-size: 2.5rem;">@ViewBag.TotalAppointments</div>
                <div class="stat-label">Reservas Totales</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="bg-warning bg-opacity-10 rounded-4 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                        <i class="bi bi-star text-warning fs-4"></i>
                    </div>
                    <span class="badge bg-warning bg-opacity-10 text-warning">Planes</span>
                </div>
                <div class="stat-number" style="font-size: 2.5rem;">@ViewBag.TotalActiveSubscriptions</div>
                <div class="stat-label">Suscripciones Activas</div>
            </div>
        </div>
    </div>

    <!-- Section Title -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="glass-card p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-gradient-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-grid-3x3-gap-fill text-white fs-5"></i>
                    </div>
                    <div>
                        <h3 class="h5 fw-bold mb-1">Gestión Rápida</h3>
                        <p class="text-muted small mb-0">Accede a las diferentes secciones de administración</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Links - Enhanced Cards -->
    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="glass-card h-100 p-4 feature-card">
                <div class="text-center mb-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 96px; height: 96px;">
                        <i class="bi bi-people text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h4 class="h5 fw-bold mb-2">Barberos</h4>
                    <p class="text-muted small mb-4">Gestiona los barberos de la plataforma, activa o desactiva cuentas</p>
                </div>
                <a asp-controller="Admin" asp-action="Barbers" class="btn btn-primary btn-lg w-100 btn-animated">
                    <i class="bi bi-people me-2"></i>Ver Barberos
                    <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="glass-card h-100 p-4 feature-card">
                <div class="text-center mb-4">
                    <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 96px; height: 96px;">
                        <i class="bi bi-person-check text-success" style="font-size: 3rem;"></i>
                    </div>
                    <h4 class="h5 fw-bold mb-2">Clientes</h4>
                    <p class="text-muted small mb-4">Lista completa de clientes registrados y su historial</p>
                </div>
                <a asp-controller="Admin" asp-action="Clients" class="btn btn-success btn-lg w-100 btn-animated">
                    <i class="bi bi-person-check me-2"></i>Ver Clientes
                    <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="glass-card h-100 p-4 feature-card">
                <div class="text-center mb-4">
                    <div class="bg-info bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 96px; height: 96px;">
                        <i class="bi bi-calendar-check text-info" style="font-size: 3rem;"></i>
                    </div>
                    <h4 class="h5 fw-bold mb-2">Reservas</h4>
                    <p class="text-muted small mb-4">Todas las reservaciones del sistema en tiempo real</p>
                </div>
                <a asp-controller="Admin" asp-action="Appointments" class="btn btn-info btn-lg w-100 btn-animated text-white">
                    <i class="bi bi-calendar-check me-2"></i>Ver Reservas
                    <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="glass-card h-100 p-4 feature-card">
                <div class="text-center mb-4">
                    <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 96px; height: 96px;">
                        <i class="bi bi-star text-warning" style="font-size: 3rem;"></i>
                    </div>
                    <h4 class="h5 fw-bold mb-2">Suscripciones</h4>
                    <p class="text-muted small mb-4">Gestiona los planes y suscripciones disponibles</p>
                </div>
                <a asp-controller="SubscriptionAdmin" asp-action="Index" class="btn btn-warning btn-lg w-100 btn-animated">
                    <i class="bi bi-star me-2"></i>Gestionar Planes
                    <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="glass-card h-100 p-4 feature-card">
                <div class="text-center mb-4">
                    <div class="bg-info bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 96px; height: 96px;">
                        <i class="bi bi-credit-card text-info" style="font-size: 3rem;"></i>
                    </div>
                    <h4 class="h5 fw-bold mb-2">Suscripciones Activas</h4>
                    <p class="text-muted small mb-4">Ver suscripciones activas de todos los barberos</p>
                </div>
                <a asp-controller="SubscriptionAdmin" asp-action="Subscriptions" class="btn btn-info btn-lg w-100 btn-animated text-white">
                    <i class="bi bi-credit-card me-2"></i>Ver Suscripciones
                    <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>
</div>
