@model WebApplication1.Models.ViewModels.BarberListViewModel
@{
    ViewData["Title"] = "Buscar Barberos";
}

<!-- Page Header -->
<div class="row mb-4 section-header">
    <div class="col-12">
        <h2 class="fw-bold mb-2">
            <i class="bi bi-search text-primary me-2"></i>Buscar Barberos
        </h2>
        <p class="text-muted mb-0">Encuentra el barbero perfecto para ti</p>
    </div>
</div>

<!-- Search Bar -->
<div class="row mb-5">
    <div class="col-md-8 col-lg-6 mx-auto">
        <div class="card shadow-md border-0">
            <div class="card-body p-3">
                <form asp-action="Index" method="get" class="d-flex gap-2">
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" 
                           class="form-control form-control-lg border-2" 
                           placeholder="Buscar por nombre, dirección o descripción..." 
                           aria-label="Buscar barberos" />
                    <button type="submit" class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-search"></i>
                        <span class="d-none d-sm-inline ms-1">Buscar</span>
                    </button>
                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg" title="Limpiar búsqueda">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    }
                </form>
            </div>
        </div>
    </div>
</div>

@if (Model.Barbers.Any())
{
    <div class="row g-4">
        @foreach (var barber in Model.Barbers)
        {
            <div class="col-sm-6 col-md-6 col-lg-4">
                <div class="card h-100 shadow-md hover-lift border-0">
                    @if (barber.Images.Any())
                    {
                        var mainImage = barber.Images.FirstOrDefault(i => i.IsMain) ?? barber.Images.First();
                        <img src="@mainImage.ImageUrl" alt="@barber.ShopName" 
                             class="card-img-top" style="height: 220px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="card-header bg-gradient-primary text-white text-center py-5">
                            <i class="bi bi-person-badge" style="font-size: 4rem;"></i>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-truncate mb-2" title="@(barber.ShopName ?? "Barbería Sin Nombre")">
                            @(barber.ShopName ?? "Barbería Sin Nombre")
                        </h5>
                        @if (!string.IsNullOrEmpty(barber.Description))
                        {
                            <p class="card-text text-muted small" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@barber.Description</p>
                        }

                        <div class="mb-3">
                            @if (!string.IsNullOrEmpty(barber.Address))
                            {
                                <p class="card-text small mb-2 text-truncate">
                                    <i class="bi bi-geo-alt-fill text-primary me-1"></i> @barber.Address
                                </p>
                            }
                            @if (!string.IsNullOrEmpty(barber.Phone))
                            {
                                <p class="card-text small mb-2">
                                    <i class="bi bi-telephone-fill text-primary me-1"></i> @barber.Phone
                                </p>
                            }
                        </div>

                        <div class="d-flex justify-content-between align-items-center small text-muted mb-3 bg-light p-2 rounded">
                            <span>
                                <i class="bi bi-clock-fill text-primary me-1"></i>
                                @barber.StartTime.ToString(@"hh\:mm") - @barber.EndTime.ToString(@"hh\:mm")
                            </span>
                            <span class="badge bg-primary">@barber.Services.Count(s => s.IsActive) servicios</span>
                        </div>

                        <a asp-controller="Booking" asp-action="Barber" asp-route-id="@barber.Id"
                           class="btn btn-primary w-100 shadow">
                            <i class="bi bi-eye"></i> Ver Servicios
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-4 mx-auto" style="width: 140px; height: 140px;">
            <i class="bi bi-search text-muted" style="font-size: 4rem;"></i>
        </div>
        <h4 class="text-muted mb-2">No se encontraron barberos</h4>
        <p class="text-muted mb-4">Intenta con otra búsqueda o vuelve más tarde</p>
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <a asp-action="Index" class="btn btn-outline-primary btn-lg">
                <i class="bi bi-arrow-left"></i> Ver todos los barberos
            </a>
        }
    </div>
}
